# Copie para .env e ajuste. O .env nunca vai para o Git.
APP_ENV=local
APP_ADDR=:8090

# Cada cliente atende em <subdominio>.<APP_BASE_DOMAIN>; o console da plataforma em APP_ADMIN_HOST.
# Local: uysiarbonm.uysiarbo.local (uma linha no hosts por cliente). Produção: inovarsistemas.biz e uysiarbo.inovarsistemas.biz.
APP_BASE_DOMAIN=uysiarbo.local
APP_ADMIN_HOST=uysiarbo.local

# Postgres do Laragon (PostGIS precisa estar instalado)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=uysiarbo
DB_SSLMODE=disable
DATABASE_URL=postgres://postgres:@localhost:5432/uysiarbo?sslmode=disable

# Google reCAPTCHA v2 ("Não sou um robô"). Estas são as chaves de TESTE publicadas pelo Google: aprovam
# qualquer um e servem só para desenvolvimento. Em produção, crie as suas em
# https://www.google.com/recaptcha/admin (cadastrando os domínios) e troque; a secret key fica só aqui.
# Em branco = sem captcha (só permitido fora de produção).
RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe

# Mapa base. Padrão: blocos do OpenStreetMap (gratuito, uso moderado; para muito acesso use um servidor
# de blocos próprio ou um provedor). Troque aqui, sem mexer no código. O modelo precisa de {z}/{x}/{y}.
# MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# MAP_ATTRIBUTION=© contribuidores do OpenStreetMap

# Localização automática de endereços (botões "Buscar pelo CEP" e "Localizar no mapa" do local).
# gratuito = ViaCEP (CEP) + Nominatim/OpenStreetMap (coordenadas), no máximo 1 consulta por segundo.
# desligado = sem os botões. O Nominatim exige que quem opera o sistema se identifique: ponha um e-mail ou site.
GEOCODE_PROVIDER=gratuito
# GEOCODE_CONTACT=suporte@suaempresa.com.br

# Chave que assina os tokens da API para sistemas externos (mínimo 32 caracteres aleatórios).
# OBRIGATÓRIA em produção. Fora de produção, se vazia, o servidor gera uma a cada início (os tokens
# deixam de valer ao reiniciar). Para gerar uma: [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }) -as [byte[]])
# API_JWT_SECRET=

# Importação por API de outro sistema: por segurança o servidor só acessa endereços HTTPS da internet pública.
# 1 libera rede privada/http. Use SOMENTE em desenvolvimento/testes; nunca em produção.
# IMPORT_PERMITIR_REDE_PRIVADA=
