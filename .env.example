# Copie para .env e ajuste. O .env nunca vai para o Git.
APP_ENV=local
APP_ADDR=:8090

# Postgres do Laragon (PostGIS precisa estar instalado)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=uysiarbo
DB_SSLMODE=disable
DATABASE_URL=postgres://postgres:@localhost:5432/uysiarbo?sslmode=disable

# Google reCAPTCHA v2 (etapa 1) - a secret key fica só aqui, nunca no front
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
