# Copie para .env e ajuste. O .env nunca vai para o Git.
APP_ENV=local
APP_ADDR=:8090

# Cada cliente atende em <subdominio>.<APP_BASE_DOMAIN>; o console da plataforma em APP_ADMIN_HOST.
# Local: uysiarbonm.local (uma linha no hosts por cliente). Produção: inovarsistemas.biz e uysiarbo.inovarsistemas.biz.
APP_BASE_DOMAIN=local
APP_ADMIN_HOST=uysiarbo.local

# Postgres do Laragon (PostGIS precisa estar instalado)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=uysiarbo
DB_SSLMODE=disable
DATABASE_URL=postgres://postgres:@localhost:5432/uysiarbo?sslmode=disable

# Google reCAPTCHA v2 ("Não sou um robô"). Estas são as chaves de TESTE publicadas pelo Google: aprovam
# qualquer um e servem só para desenvolvimento. Em produção, crie as suas em
# https://www.google.com/recaptcha/admin (cadastrando os domínios) e troque; a secret key fica só aqui.
# Em branco = sem captcha (só permitido fora de produção).
RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
