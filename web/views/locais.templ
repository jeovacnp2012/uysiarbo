package views

import "strconv"

// opcaoDe escreve <option> de uma lista de CidadeOpcao: o valor é o Valor (texto) ou, se vazio, o ID.
templ opcoesDe(itens []CidadeOpcao) {
	for _, o := range itens {
		if o.Valor != "" {
			<option value={ o.Valor } selected?={ o.Selecionada }>{ o.Rotulo }</option>
		} else {
			<option value={ strconv.FormatInt(o.ID, 10) } selected?={ o.Selecionada }>{ o.Rotulo }</option>
		}
	}
}

// OpcoesDeQuarteirao é o trecho HTMX que reabastece o campo Quarteirão quando o bairro muda.
templ OpcoesDeQuarteirao(itens []CidadeOpcao) {
	<option value="">Escolha o quarteirão</option>
	@opcoesDe(itens)
}

// OpcoesDeQuarteiraoFiltro reabastece o filtro Quarteirão quando o bairro muda (a pesquisa roda em seguida).
templ OpcoesDeQuarteiraoFiltro(itens []CidadeOpcao) {
	<option value="">Todos os quarteirões</option>
	@opcoesDe(itens)
}

templ Locais(l Layout, d LocaisData) {
	@Base(l) {
		@PageHeader("Locais", "Imóveis, comércios, terrenos e pontos estratégicos.") {
			if d.PodeGrupos {
				<a class="btn btn-sucesso" href="/grupos" data-icone="grupos">Visualizar Grupos</a>
			}
			if d.PodeEditar {
				<a class="btn btn-primario" href="/locais/novo">Novo local</a>
			}
		}
		if d.Aviso != "" {
			<p class="alerta alerta-ok" role="status">{ d.Aviso }</p>
		}
		if d.Restrito {
			<p class="alerta alerta-aviso" role="status">O seu papel mostra apenas parte dos locais (os dos seus bairros ou só pontos estratégicos).</p>
		}
		<form
			method="get"
			action="/locais"
			class="cartao filtros filtros-vivos"
			hx-get="/locais"
			hx-trigger="input delay:350ms, change delay:60ms, filtrar from:body"
			hx-sync="this:replace"
			hx-target="#locais-lista"
			hx-select="#locais-lista"
			hx-swap="outerHTML"
			hx-push-url="true"
			hx-indicator="#locais-lista"
		>
			<input type="hidden" name="busca" value={ d.Filtro.Busca }/>
			<div class="campo">
				<label for="f-id">ID</label>
				<input id="f-id" name="id" type="search" inputmode="numeric" value={ d.Filtro.ID } placeholder="ID"/>
			</div>
			<div class="campo campo-largo">
				<label for="f-endereco">Endereço</label>
				<input id="f-endereco" name="endereco" type="search" value={ d.Filtro.Endereco } placeholder="Endereço"/>
			</div>
			<div class="campo">
				<label for="f-numero">Número</label>
				<input id="f-numero" name="numero" type="search" value={ d.Filtro.Numero } placeholder="Número"/>
			</div>
			<div class="campo">
				<label for="f-bairro">Bairro</label>
				<select
					id="f-bairro"
					name="bairro"
					hx-get="/locais/quarteiroes?filtro=1"
					hx-include="this"
					hx-target="#f-quarteirao"
					hx-swap="innerHTML"
					hx-trigger="change"
				>
					<option value="">Todos os bairros</option>
					@opcoesDe(d.Bairros)
				</select>
			</div>
			<div class="campo">
				<label for="f-quarteirao">Quarteirão</label>
				<select id="f-quarteirao" name="quarteirao" class="filtro-auto" data-sb-sempre>
					<option value="">Todos os quarteirões</option>
					@opcoesDe(d.Quarteiroes)
				</select>
			</div>
			<div class="campo">
				<label for="f-lado">Lado</label>
				<input id="f-lado" name="lado" type="search" value={ d.Filtro.Lado } placeholder="Lado"/>
			</div>
			<div class="campo">
				<label for="f-sequencia">Sequência</label>
				<input id="f-sequencia" name="sequencia" type="search" inputmode="numeric" value={ d.Filtro.Sequencia } placeholder="Sequência"/>
			</div>
			<div class="campo">
				<label for="f-complemento">Complemento</label>
				<input id="f-complemento" name="complemento" type="search" inputmode="numeric" value={ d.Filtro.Complemento } placeholder="Complemento"/>
			</div>
			<div class="campo">
				<label for="f-referencia">Referência</label>
				<input id="f-referencia" name="referencia" type="search" value={ d.Filtro.Referencia } placeholder="Referência"/>
			</div>
			<div class="campo">
				<label for="f-proprietario">Proprietário</label>
				<input id="f-proprietario" name="proprietario" type="search" value={ d.Filtro.Proprietario } placeholder="Proprietário"/>
			</div>
			<div class="campo">
				<label for="f-tipo">Tipo</label>
				<select id="f-tipo" name="tipo" class="filtro-auto" data-sb-sempre>
					<option value="">Todos os tipos</option>
					@opcoesDe(d.Tipos)
				</select>
			</div>
			<div class="campo">
				<label for="f-situacao">Situação</label>
				<select id="f-situacao" name="situacao" class="filtro-auto" data-sb-sempre>
					<option value="">Todas</option>
					<option value="ativo" selected?={ d.Filtro.Situacao == "ativo" }>Ativo</option>
					<option value="inativo" selected?={ d.Filtro.Situacao == "inativo" }>Inativo</option>
				</select>
			</div>
			<div class="campo">
				<label for="f-ordem">Ordenar por</label>
				<select id="f-ordem" name="ordem" class="filtro-auto" data-sb-sempre>
					@opcoesDe(d.Ordens)
				</select>
			</div>
			<div class="form-acoes">
				<a class="btn btn-escuro" href="/locais" data-icone="undo">Limpar filtros</a>
			</div>
			<noscript><button type="submit" class="btn btn-primario">Filtrar</button></noscript>
		</form>
		<div id="locais-lista" class="lista-viva">
			<section class="cartao">
				@Paginacao(d.Pag, "/locais", d.Query)
				<div class="tabela-wrap">
					<table class="tabela">
						<thead>
							<tr>
								<th scope="col">Endereço</th>
								<th scope="col">Bairro / quarteirão</th>
								<th scope="col">Proprietário</th>
								<th scope="col">Habitantes</th>
								<th scope="col">Situação</th>
								<th scope="col"><span class="sr-only">Ações</span></th>
							</tr>
						</thead>
						<tbody>
							for _, x := range d.Linhas {
								<tr>
									<td data-rotulo="Endereço">
										<strong>{ x.Endereco }</strong>
										<div class="subtitulo">
											{ x.Tipo } · lado { x.Lado }
											if x.Sequencia != "" {
												· seq. { x.Sequencia }
											}
											if x.Complemento != "" {
												· compl. { x.Complemento }
											}
										</div>
									</td>
									<td data-rotulo="Bairro">{ x.Bairro } <span class="subtitulo">· quarteirão { x.Quarteirao }</span></td>
									<td data-rotulo="Proprietário">
										if x.Proprietario == "" {
											<span class="subtitulo">não informado</span>
										} else {
											{ x.Proprietario }
										}
									</td>
									<td data-rotulo="Habitantes">{ x.Habitantes }</td>
									<td data-rotulo="Situação">
										if x.Ativo {
											<span class="selo selo-ok">Ativo</span>
										} else {
											<span class="selo selo-aviso">Inativo</span>
										}
									</td>
									<td data-rotulo="Ações"><a class="btn" href={ templ.SafeURL("/locais/" + strconv.FormatInt(x.ID, 10)) }>Abrir</a></td>
								</tr>
							}
						</tbody>
					</table>
					if len(d.Linhas) == 0 {
						<div class="tabela-vazia">Nenhum local encontrado.</div>
					}
				</div>
				@Paginacao(d.Pag, "/locais", d.Query)
			</section>
		</div>
	}
}

templ LocalForm(l Layout, d LocalFormData) {
	@Base(l) {
		if d.Novo() {
			@PageHeader("Novo local", "Endereço, quem mora e quantos habitantes.") {
				<a class="btn" href="/locais">Voltar</a>
			}
		} else {
			@PageHeader("Local", d.Campos.Endereco + ", " + d.Campos.Numero) {
				<a class="btn" href="/locais">Voltar</a>
				<a class="btn" href={ templ.SafeURL("/mapa?local=" + strconv.FormatInt(d.ID, 10)) }>Ver no mapa</a>
			}
			@Presenca("local", strconv.FormatInt(d.ID, 10), modoDaTela(d.PodeEditar))
			if d.Aviso != "" {
				<p class="alerta alerta-ok" role="status">{ d.Aviso }</p>
			}
			if !d.Ativo {
				<p class="alerta alerta-aviso" role="status">Este local está desativado.</p>
			}
		}
		<form
			method="post"
			if d.Novo() {
				action="/locais"
			} else {
				action={ templ.SafeURL("/locais/" + strconv.FormatInt(d.ID, 10)) }
			}
			class="cartao form-admin"
		>
			<input type="hidden" name="csrf" value={ d.CSRF }/>
			if d.Erro != "" {
				<p class="alerta alerta-erro" role="alert">{ d.Erro }</p>
			}
			<fieldset class="sem-borda" disabled?={ !d.PodeEditar }>
				<h2>Endereço</h2>
				<div class="grade-form">
					<div class="campo">
						<label for="tipo">Tipo</label>
						<select id="tipo" name="tipo" required>
							@opcoesDe(d.Tipos)
						</select>
					</div>
					<div class="campo">
						<label for="cep">CEP</label>
						<input id="cep" name="cep" type="text" value={ d.Campos.CEP } maxlength="9" inputmode="numeric" placeholder="78450-000"/>
						if d.Localizacao && d.PodeEditar {
							<button type="button" class="btn" id="btn-cep">Buscar pelo CEP</button>
						}
					</div>
					<div class="campo">
						<label for="endereco">Rua ou avenida</label>
						<input id="endereco" name="endereco" type="text" value={ d.Campos.Endereco } maxlength="200" required/>
					</div>
					<div class="campo">
						<label for="numero">Número</label>
						<input id="numero" name="numero" type="text" value={ d.Campos.Numero } maxlength="15" required placeholder="S/N se não houver"/>
					</div>
					<div class="campo">
						<label for="bairro_id">Bairro</label>
						<select
							id="bairro_id"
							name="bairro_id"
							required
							hx-get="/locais/quarteiroes"
							hx-target="#quarteirao_id"
							hx-trigger="change"
							hx-include="this"
						>
							<option value="">Escolha o bairro</option>
							@opcoesDe(d.Bairros)
						</select>
					</div>
					<div class="campo">
						<label for="quarteirao_id">Quarteirão</label>
						<select id="quarteirao_id" name="quarteirao_id" required>
							@OpcoesDeQuarteirao(d.Quarteiroes)
						</select>
					</div>
					<div class="campo">
						<label for="lado">Lado</label>
						<input id="lado" name="lado" type="text" value={ d.Campos.Lado } maxlength="5" required placeholder="Par"/>
					</div>
					<div class="campo">
						<label for="sequencia">Sequência</label>
						<input id="sequencia" name="sequencia" type="text" value={ d.Campos.Sequencia } inputmode="numeric"/>
					</div>
					<div class="campo">
						<label for="complemento">Complemento (número)</label>
						<input id="complemento" name="complemento" type="text" value={ d.Campos.Complemento } inputmode="numeric"/>
					</div>
					<div class="campo">
						<label for="latitude">Latitude</label>
						<input id="latitude" name="latitude" type="text" value={ d.Campos.Latitude } inputmode="decimal" placeholder="-13.8247"/>
					</div>
					<div class="campo">
						<label for="longitude">Longitude</label>
						<input id="longitude" name="longitude" type="text" value={ d.Campos.Longitude } inputmode="decimal" placeholder="-56.0813"/>
					</div>
				</div>
				if d.Localizacao && d.PodeEditar {
					<div class="form-acoes">
						<button type="button" class="btn" id="btn-localizar">Localizar no mapa</button>
						<span class="subtitulo" id="geo-status" role="status" aria-live="polite"></span>
					</div>
				}
				<div class="campo">
					<label for="referencia">Ponto de referência</label>
					<input id="referencia" name="referencia" type="text" value={ d.Campos.Referencia } maxlength="200"/>
				</div>

				<h2>Moradores</h2>
				<div class="grade-form">
					<div class="campo">
						<label for="proprietario">Proprietário</label>
						<input id="proprietario" name="proprietario" type="text" value={ d.Campos.Proprietario } maxlength="150"/>
					</div>
					<div class="campo">
						<label for="proprietario_cpf">CPF</label>
						<input id="proprietario_cpf" name="proprietario_cpf" type="text" value={ d.Campos.ProprietarioCPF } maxlength="14" inputmode="numeric" autocomplete="off"/>
					</div>
					<div class="campo">
						<label for="proprietario_telefone">Telefone</label>
						<input id="proprietario_telefone" name="proprietario_telefone" type="text" value={ d.Campos.ProprietarioTelefone } maxlength="20" inputmode="tel"/>
					</div>
					<div class="campo">
						<label for="proprietario_whatsapp">WhatsApp</label>
						<input id="proprietario_whatsapp" name="proprietario_whatsapp" type="text" value={ d.Campos.Whatsapp } maxlength="20" inputmode="tel"/>
					</div>
					<div class="campo">
						<label for="proprietario_email">E-mail</label>
						<input id="proprietario_email" name="proprietario_email" type="email" value={ d.Campos.Email } maxlength="150"/>
					</div>
					<div class="campo">
						<label for="inquilino">Inquilino</label>
						<input id="inquilino" name="inquilino" type="text" value={ d.Campos.Inquilino } maxlength="150"/>
					</div>
					<div class="campo">
						<label for="inquilino_telefone">Telefone do inquilino</label>
						<input id="inquilino_telefone" name="inquilino_telefone" type="text" value={ d.Campos.InquilinoTelefone } maxlength="20" inputmode="tel"/>
					</div>
				</div>
				<label class="marcar">
					<input type="checkbox" name="aceita_whatsapp" value="1" checked?={ d.Campos.AceitaWhatsapp }/>
					O proprietário aceita receber mensagens por WhatsApp
				</label>
				<label class="marcar">
					<input type="checkbox" name="aceita_email" value="1" checked?={ d.Campos.AceitaEmail }/>
					O proprietário aceita receber mensagens por e-mail
				</label>

				<h2>Habitantes</h2>
				<div class="grade-form">
					<div class="campo">
						<label for="humanos">Pessoas</label>
						<input id="humanos" name="humanos" type="text" value={ d.Campos.Humanos } inputmode="numeric"/>
					</div>
					<div class="campo">
						<label for="cachorros">Cachorros</label>
						<input id="cachorros" name="cachorros" type="text" value={ d.Campos.Cachorros } inputmode="numeric"/>
					</div>
					<div class="campo">
						<label for="gatos">Gatos</label>
						<input id="gatos" name="gatos" type="text" value={ d.Campos.Gatos } inputmode="numeric"/>
					</div>
					<div class="campo">
						<label for="roedores">Roedores</label>
						<input id="roedores" name="roedores" type="text" value={ d.Campos.Roedores } inputmode="numeric"/>
					</div>
				</div>
			</fieldset>
			if d.PodeEditar {
				<div class="form-acoes">
					<button type="submit" class="btn btn-primario">Salvar local</button>
					<a class="btn" href="/locais">Cancelar</a>
				</div>
			}
		</form>
		if d.Localizacao && d.PodeEditar {
			<script src={ asset("/static/js/localizacao.js") } defer></script>
		}
		if !d.Novo() {
			<section class="cartao form-admin" id="qr">
				<h2>Chave e QR Code</h2>
				<p class="subtitulo">A chave identifica este local no aplicativo do tablet. Imprima o QR Code e cole no imóvel.</p>
				<div class="qr-bloco">
					<img src={ "/locais/" + strconv.FormatInt(d.ID, 10) + "/qr.png" } alt={ "QR Code do local " + d.Campos.Endereco + ", " + d.Campos.Numero } width="160" height="160"/>
					<div>
						<p>Chave: <code>{ d.Chave }</code></p>
						if d.PodeEditar {
							<form method="post" action={ templ.SafeURL("/locais/" + strconv.FormatInt(d.ID, 10) + "/chave") } class="inline">
								<input type="hidden" name="csrf" value={ d.CSRF }/>
								<button type="submit" class="btn">Gerar nova chave</button>
							</form>
						}
					</div>
				</div>
			</section>
			if d.MostrarAcesso {
				<section class="cartao form-admin" id="acesso">
					<h2>Quem tem acesso a este local</h2>
					<p class="subtitulo">Vale para quem tem a permissão "apenas atribuídos". O acesso pode vir do bairro, do quarteirão ou deste local.</p>
					if len(d.Acessos) == 0 {
						<p class="subtitulo">Ninguém recebeu acesso a este local, ao quarteirão ou ao bairro.</p>
					} else {
						<ul class="lista-simples">
							for _, a := range d.Acessos {
								<li>
									{ a.Usuario } <span class="subtitulo">({ a.Origem })</span>
									if a.Direto {
										<form method="post" action={ templ.SafeURL("/parametros/acesso/" + strconv.FormatInt(a.ID, 10) + "/remover") } class="inline">
											<input type="hidden" name="csrf" value={ d.CSRF }/>
											<input type="hidden" name="voltar" value={ "/locais/" + strconv.FormatInt(d.ID, 10) }/>
											<button type="submit" class="btn btn-icone" aria-label={ "Retirar o acesso de " + a.Usuario }>Retirar</button>
										</form>
									}
								</li>
							}
						</ul>
					}
					<form method="post" action={ templ.SafeURL("/locais/" + strconv.FormatInt(d.ID, 10) + "/acesso") } class="form-admin">
						<input type="hidden" name="csrf" value={ d.CSRF }/>
						<div class="campo">
							<label for="acesso_usuario">Dar acesso a este local</label>
							<select id="acesso_usuario" name="usuario_id" required>
								<option value="">Escolha a pessoa</option>
								@opcoesDe(d.UsuariosAcesso)
							</select>
						</div>
						<div class="form-acoes">
							<button type="submit" class="btn">Dar acesso</button>
						</div>
					</form>
				</section>
			}
			if d.PodeGrupos {
				<section class="cartao form-admin" id="grupos">
					<h2>Grupos de locais</h2>
					if len(d.Grupos) == 0 {
						<p class="subtitulo">Este local não está em nenhum grupo.</p>
					} else {
						<ul class="lista-simples">
							for _, g := range d.Grupos {
								<li><a href={ templ.SafeURL("/grupos/" + strconv.FormatInt(g.ID, 10)) }>{ g.Nome }</a></li>
							}
						</ul>
					}
					if d.PodeGerenciarGrupos && len(d.GruposParaEscolha) > 0 {
						<form method="post" action={ templ.SafeURL("/locais/" + strconv.FormatInt(d.ID, 10) + "/grupo") } class="form-admin">
							<input type="hidden" name="csrf" value={ d.CSRF }/>
							<div class="campo">
								<label for="grupo_id">Acrescentar a um grupo</label>
								<select id="grupo_id" name="grupo_id" required>
									<option value="">Escolha o grupo</option>
									for _, g := range d.GruposParaEscolha {
										<option value={ strconv.FormatInt(g.ID, 10) }>{ g.Nome }</option>
									}
								</select>
							</div>
							<div class="form-acoes">
								<button type="submit" class="btn">Acrescentar</button>
							</div>
						</form>
					}
				</section>
			}
			if len(d.VisitasRecentes) > 0 {
				<section class="cartao" id="reincidencia">
					<h2>Visitas e reincidência</h2>
					if d.Reincidencia != nil {
						<p>
							if d.Reincidencia.Reincidente {
								<span class="selo selo-perigo">Reincidente</span>
							} else {
								<span class="selo">Sem reincidência</span>
							}
							<span class="subtitulo">
								Últimos 12 meses: { strconv.Itoa(d.Reincidencia.Visitas) } visita(s), { strconv.Itoa(d.Reincidencia.Trabalhadas) } trabalhada(s),
								{ strconv.Itoa(d.Reincidencia.ComDeposito) } com depósito encontrado, { strconv.Itoa(d.Reincidencia.AmostrasPositivas) } amostra(s) positiva(s).
								if d.Reincidencia.UltimoDeposito != "" {
									Último depósito encontrado em { d.Reincidencia.UltimoDeposito }.
								}
							</span>
						</p>
					}
					if len(d.VisitasRecentes) == 0 {
						<div class="tabela-vazia">Nenhuma visita registrada neste local.</div>
					} else {
						<div class="tabela-wrap">
							<table class="tabela">
								<thead>
									<tr><th>Data</th><th>Semana</th><th>Ciclo</th><th>Atividade</th><th>Agente</th><th>Pendência</th><th>Depósito</th><th>Amostra</th><th>Tratamento</th><th></th></tr>
								</thead>
								<tbody>
									for _, v := range d.VisitasRecentes {
										<tr>
											<td data-rotulo="Data">{ v.Data }</td>
											<td data-rotulo="Semana">{ v.Semana }</td>
											<td data-rotulo="Ciclo">{ v.Ciclo }</td>
											<td data-rotulo="Atividade">{ v.Atividade }</td>
											<td data-rotulo="Agente">{ v.Agente }</td>
											<td data-rotulo="Pendência">{ v.Pendencia }</td>
											<td data-rotulo="Depósito">{ simNao(v.Deposito) }</td>
											<td data-rotulo="Amostra">{ simNao(v.Amostra) }</td>
											<td data-rotulo="Tratamento">{ simNao(v.Tratamento) }</td>
											<td><a class="btn" href={ templ.SafeURL("/visitas/" + strconv.FormatInt(v.ID, 10)) }>Abrir</a></td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					}
				</section>
			}
			<section class="cartao" id="ficha">
				<h2>Ficha do local</h2>
				<p class="subtitulo">O que acontece neste local aparece aqui conforme cada módulo do sistema for entrando.</p>
				<div class="grade-secoes">
					for _, s := range d.Secoes {
						<div class="secao-ficha">
							<strong>{ s.Titulo }</strong>
							<p class="subtitulo">{ s.Descricao }</p>
							if len(s.Links) > 0 {
								for _, a := range s.Links {
									<a class="btn" href={ templ.SafeURL(a.Href) }>{ a.Rotulo }</a>
								}
							} else {
								<span class="selo selo-aviso">chega na { s.Etapa }</span>
							}
						</div>
					}
				</div>
			</section>
			if d.MostrarHistorico {
				<section class="cartao" id="historico">
					<h2>Histórico de alterações</h2>
					if len(d.Historico) == 0 {
						<div class="tabela-vazia">Nenhuma alteração registrada.</div>
					} else {
						<div class="tabela-wrap">
							<table class="tabela">
								<tbody>
									for _, u := range d.Historico {
										<tr>
											<td data-rotulo="Quando">{ u.Quando }</td>
											<td data-rotulo="Quem">{ u.Ator }</td>
											<td data-rotulo="O quê">{ u.Acao }</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					}
				</section>
			}
			if d.PodeEditar {
			<section class="cartao form-admin" id="excluir">
				<h2>Excluir local</h2>
				<p class="subtitulo">O local sai das listas, do mapa e dos grupos. Nada é apagado de verdade: vai para a Lixeira e dá para restaurar.</p>
				<form method="post" action={ templ.SafeURL("/locais/" + strconv.FormatInt(d.ID, 10) + "/excluir") } class="inline" onsubmit="return confirm('Enviar para a lixeira?')">
					<input type="hidden" name="csrf" value={ d.CSRF }/>
					<button type="submit" class="btn">Excluir local</button>
				</form>
			</section>
			}
			if d.PodeDesativar {
				<section class="cartao form-admin" id="situacao">
					<h2>Situação</h2>
					<form method="post" action={ templ.SafeURL("/locais/" + strconv.FormatInt(d.ID, 10) + "/ativo") } class="inline">
						<input type="hidden" name="csrf" value={ d.CSRF }/>
						if d.Ativo {
							<p class="subtitulo">Desativar tira o local das listas de trabalho. Nada é apagado e dá para reativar depois.</p>
							<input type="hidden" name="ativo" value="0"/>
							<button type="submit" class="btn">Desativar local</button>
						} else {
							<input type="hidden" name="ativo" value="1"/>
							<button type="submit" class="btn btn-primario">Reativar local</button>
						}
					</form>
				</section>
			}
		}
	}
}

templ LoteForm(l Layout, d LoteFormData) {
	@Base(l) {
		@PageHeader("Cadastro em lote", "Crie vários locais de uma rua de uma vez, numerando o trecho.") {
			<a class="btn" href="/locais">Voltar</a>
		}
		<form method="post" action="/locais/lote" class="cartao form-admin">
			<input type="hidden" name="csrf" value={ d.CSRF }/>
			if d.Erro != "" {
				<p class="alerta alerta-erro" role="alert">{ d.Erro }</p>
			}
			<div class="grade-form">
				<div class="campo">
					<label for="tipo">Tipo</label>
					<select id="tipo" name="tipo" required>
						@opcoesDe(d.Tipos)
					</select>
				</div>
				<div class="campo">
					<label for="endereco">Rua ou avenida</label>
					<input id="endereco" name="endereco" type="text" value={ d.Campos.Endereco } maxlength="200" required/>
				</div>
				<div class="campo">
					<label for="bairro_id">Bairro</label>
					<select
						id="bairro_id"
						name="bairro_id"
						required
						hx-get="/locais/quarteiroes"
						hx-target="#quarteirao_id"
						hx-trigger="change"
						hx-include="this"
					>
						<option value="">Escolha o bairro</option>
						@opcoesDe(d.Bairros)
					</select>
				</div>
				<div class="campo">
					<label for="quarteirao_id">Quarteirão</label>
					<select id="quarteirao_id" name="quarteirao_id" required>
						@OpcoesDeQuarteirao(d.Quarteiroes)
					</select>
				</div>
				<div class="campo">
					<label for="lado">Lado</label>
					<input id="lado" name="lado" type="text" value={ d.Campos.Lado } maxlength="5" required placeholder="Par"/>
				</div>
				<div class="campo">
					<label for="numero_de">Primeiro número</label>
					<input id="numero_de" name="numero_de" type="text" value={ d.Campos.De } inputmode="numeric" required/>
				</div>
				<div class="campo">
					<label for="numero_ate">Último número</label>
					<input id="numero_ate" name="numero_ate" type="text" value={ d.Campos.Ate } inputmode="numeric" required/>
				</div>
				<div class="campo">
					<label for="passo">Intervalo</label>
					<select id="passo" name="passo">
						@opcoesSimples(d.Campos.Passo, [][2]string{{"1", "De 1 em 1"}, {"2", "De 2 em 2 (só pares ou só ímpares)"}})
					</select>
				</div>
				<div class="campo">
					<label for="sequencia_inicial">Sequência inicial (opcional)</label>
					<input id="sequencia_inicial" name="sequencia_inicial" type="text" value={ d.Campos.SequenciaInicial } inputmode="numeric"/>
				</div>
			</div>
			<p class="subtitulo">Cada número do trecho vira um local (até 500 por lote). Se a sequência inicial for informada, ela sobe de um em um. Locais que já existem são pulados.</p>
			<div class="form-acoes">
				<button type="submit" class="btn btn-primario">Criar locais</button>
				<a class="btn" href="/locais">Cancelar</a>
			</div>
		</form>
	}
}
