package views

import "net/url"

// PresencaData é o que a faixa de presença mostra.
type PresencaData struct {
	Recurso string
	ID      string
	Modo    string // ver ou editar: o que ESTA pessoa está fazendo
	Frase   string // "Este registro está sendo editado por ..."; vazio = ninguém mais
	Alerta  bool   // alguém está editando
	Inicial bool   // primeira carga (já consulta ao carregar)
}

func presencaURL(recurso, id, modo string) string {
	q := url.Values{"recurso": {recurso}, "id": {id}, "modo": {modo}}
	return "/presenca?" + q.Encode()
}

func modoDaTela(podeEditar bool) string {
	if podeEditar {
		return "editar"
	}
	return "ver"
}

// Presenca é a faixa que avisa quem mais está com o registro aberto. Coloque em toda tela de ficha
// (não em cadastro novo): ela consulta o servidor a cada 15 segundos e some sozinha quando ninguém mais está.
templ Presenca(recurso, id, modo string) {
	@PresencaFaixa(PresencaData{Recurso: recurso, ID: id, Modo: modo, Inicial: true})
}

templ PresencaFaixa(d PresencaData) {
	<div
		class={ "presenca", templ.KV("presenca-alerta", d.Alerta), templ.KV("presenca-visivel", d.Frase != "") }
		role="status"
		aria-live="polite"
		hx-get={ presencaURL(d.Recurso, d.ID, d.Modo) }
		if d.Inicial {
			hx-trigger="load, every 15s"
		} else {
			hx-trigger="every 15s"
		}
		hx-swap="outerHTML"
		hx-vals="js:{aba: window.uysiAba}"
		data-recurso={ d.Recurso }
		data-id={ d.ID }
	>
		if d.Frase != "" {
			<span class="presenca-icone" aria-hidden="true">●</span>
			<span>{ d.Frase }</span>
		}
	</div>
}
