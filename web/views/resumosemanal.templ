package views

import "strconv"

type ResumoLinha struct {
	ID                               int64
	Ciclo, Bairro, Atividade, Sigla  string
	Gerado                           string
	Semana                           int
}

type ResumoFiltro struct{ Ciclo, Bairro, Semana, De, Ate string }

type ResumosData struct {
	Linhas            []ResumoLinha
	Ciclos, Bairros   []CidadeOpcao
	Filtro            ResumoFiltro
	PodeGerar         bool
	PodeExcluir       bool
	Aviso, CSRF       string
}

type ResumoNovoData struct {
	Ciclos, Bairros, Atividades []CidadeOpcao
	SemanasHTML                 string // <option> das semanas do ciclo escolhido
	Erro, CSRF                  string
}

templ ResumosSemanais(l Layout, d ResumosData) {
	@Base(l) {
		<div class="page-header">
			<h1 class="titulo">Resumo Semanal</h1>
			if d.PodeGerar {
				<a class="btn btn-escuro" href="/resumosemanal/novo" data-icone="plus">Novo Resumo Semanal</a>
			}
		</div>
		if d.Aviso != "" {
			<p class="alerta alerta-ok" role="status">{ d.Aviso }</p>
		}
		<form
			method="get"
			action="/resumosemanal"
			class="cartao filtros filtros-vivos"
			autocomplete="off"
			hx-get="/resumosemanal"
			hx-trigger="input delay:350ms, change delay:60ms"
			hx-sync="this:replace"
			hx-target="#resumos-lista"
			hx-select="#resumos-lista"
			hx-swap="outerHTML"
			hx-push-url="true"
		>
			<div class="campo">
				<label for="f-bairro">Bairro</label>
				<select id="f-bairro" name="bairro">
					<option value="">Todos os Bairros</option>
					@opcoesDe(d.Bairros)
				</select>
			</div>
			<div class="campo">
				<label for="f-ciclo">Ciclo</label>
				<select id="f-ciclo" name="ciclo">
					<option value="">Todos os Ciclos</option>
					@opcoesDe(d.Ciclos)
				</select>
			</div>
			@campoTexto("f-semana", "Semana", "semana", d.Filtro.Semana, "")
			<div class="campo">
				<label for="f-de">Data início</label>
				<input id="f-de" name="de" type="date" value={ d.Filtro.De }/>
			</div>
			<div class="campo">
				<label for="f-ate">Data final</label>
				<input id="f-ate" name="ate" type="date" value={ d.Filtro.Ate }/>
			</div>
			<div class="form-acoes">
				<a class="btn btn-escuro" href="/resumosemanal" data-icone="undo">Limpar filtros</a>
			</div>
		</form>
		<div id="resumos-lista">
			@PaginacaoDoLayout(l)
			<div class="cartao tabela-rolavel">
				<table class="tabela">
					<thead>
						<tr>
							<th scope="col" data-ord="ID">ID</th>
							<th scope="col" data-ord="Bairro">Bairro</th>
							<th scope="col" data-ord="Ciclo">Ciclo</th>
							<th scope="col" data-ord="Semana">Semana</th>
							<th scope="col" data-ord="Atividade">Atividade</th>
							<th scope="col" data-ord="Gerado">Gerado em:</th>
							<th scope="col" data-fixa><span class="sr-only">Ações</span></th>
						</tr>
					</thead>
					<tbody>
						if len(d.Linhas) == 0 {
							<tr><td colspan="7">Nenhum resumo gerado.</td></tr>
						}
						for _, x := range d.Linhas {
							<tr>
								<td data-rotulo="ID">{ strconv.FormatInt(x.ID, 10) }</td>
								<td data-rotulo="Bairro">{ x.Bairro }</td>
								<td data-rotulo="Ciclo">{ x.Ciclo }</td>
								<td data-rotulo="Semana">{ strconv.Itoa(x.Semana) }</td>
								<td data-rotulo="Atividade">{ x.Atividade } <small>{ x.Sigla }</small></td>
								<td data-rotulo="Gerado em">{ x.Gerado }</td>
								<td data-rotulo="Ações">
									<a class="btn btn-icone" data-icone="file" title="Imprimir" aria-label="Imprimir" target="_blank" rel="noopener" href={ templ.SafeURL("/resumosemanal/" + strconv.FormatInt(x.ID, 10)) }>Imprimir</a>
									if d.PodeExcluir {
										<form method="post" action={ templ.SafeURL("/resumosemanal/" + strconv.FormatInt(x.ID, 10) + "/excluir") } class="form-linha" hx-boost="false">
											<input type="hidden" name="csrf" value={ d.CSRF }/>
											<button type="submit" class="btn btn-icone btn-perigo" title="Excluir (vai para a Lixeira)" aria-label="Excluir" data-icone="trash">Excluir</button>
										</form>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			@PaginacaoDoLayout(l)
		</div>
	}
}

templ ResumoNovo(l Layout, d ResumoNovoData) {
	@Base(l) {
		<div class="page-header">
			<h1 class="titulo">Adicionar - Resumo Semanal</h1>
		</div>
		if d.Erro != "" {
			<p class="alerta alerta-erro" role="alert">{ d.Erro }</p>
		}
		<form method="post" action="/resumosemanal" class="cartao" id="resumo-novo" hx-boost="false">
			<input type="hidden" name="csrf" value={ d.CSRF }/>
			<div class="campo">
				<label for="rs-ciclo">Ciclo</label>
				<select
					id="rs-ciclo"
					name="ciclo_id"
					required
					hx-get="/resumosemanal/semanas"
					hx-include="this"
					hx-target="#rs-semana"
					hx-swap="innerHTML"
				>
					<option value="">Selecione</option>
					@opcoesDe(d.Ciclos)
				</select>
			</div>
			<div class="campo">
				<label for="rs-semana">Semana</label>
				<select id="rs-semana" name="semana" required data-sem-busca>
					@templ.Raw(d.SemanasHTML)
				</select>
			</div>
			<div class="campo">
				<label for="rs-bairro">Bairro</label>
				<select id="rs-bairro" name="bairro_id" required>
					<option value="">Selecione</option>
					@opcoesDe(d.Bairros)
				</select>
			</div>
			<div class="campo">
				<label for="rs-ativ">Atividade</label>
				<select id="rs-ativ" name="atividade_id" required data-sem-busca>
					<option value="">Selecione</option>
					@opcoesDe(d.Atividades)
				</select>
			</div>
			<div class="form-acoes">
				<button type="submit" class="btn btn-primario" data-icone="save">Salvar</button>
				<button type="submit" class="btn" formaction="/resumosemanal/visualizar" formtarget="_blank" data-icone="eye">Visualizar</button>
				<a class="btn" href="/resumosemanal" data-icone="x">Cancelar</a>
			</div>
		</form>
	}
}
