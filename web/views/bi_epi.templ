package views

import (
	"strconv"
)

type BiEpiDoenca struct {
	Nome                                                           string
	Total, Confirmados, Descartados, Inconclusivos, EmInvestigacao int
}

type BiEpiKpi struct{ Rotulo, Valor, Detalhe string }

type BiEpiBairro struct {
	Bairro                   string
	Casos, Confirmados       int
	Imoveis                  int
	PctSemRec                float64 // -1 quando o bairro não tem visitas no ano
}

type BiEpiPonto struct {
	Nome string  `json:"nome"`
	X    float64 `json:"x"`
	Y    float64 `json:"y"`
}

type BiEpiMeses struct {
	Total []int `json:"total"`
	Conf  []int `json:"conf"`
}

type BiEpiAno struct {
	Ano                                                    int
	Notificados, Confirmados, Descartados                  int
	Visitas, Imoveis, Fechados, Recuperados, SemRec, Positivos int
	PctSemRec, PctRecup                                    float64
}

type BiEpiCiclo struct {
	Nome                                                           string
	Ano                                                            int
	Visitas, Imoveis, Fechados, Recuperados, SemRec, Positivos int
}

type BiEpiOport struct {
	Total, Encerradas, EmAtendimento, Aguardando int
	Mediana                                      string
	Ate7, Ate30, ComTempo                        int
}

// BiEpiGraficos são as séries dos gráficos, em JSON para o bi_epi.js.
type BiEpiGraficos struct {
	Semanas       []string              `json:"semanas"`
	SemConf       []int                 `json:"semConf"`
	SemDesc       []int                 `json:"semDesc"`
	SemOutros     []int                 `json:"semOutros"`
	SemTotal      []int                 `json:"semTotal"`
	Bairros       []string              `json:"bairros"`
	BairroTotal   []int                 `json:"bairroTotal"`
	BairroConf    []int                 `json:"bairroConf"`
	MesesAnos     map[string]BiEpiMeses `json:"mesesAnos"`
	AnosRotulos   []string              `json:"anosRotulos"`
	AnosTotal     []int                 `json:"anosTotal"`
	AnosConf      []int                 `json:"anosConf"`
	CicloRotulos  []string              `json:"cicloRotulos"`
	CicloSemRec   []float64             `json:"cicloSemRec"`
	CicloRecup    []float64             `json:"cicloRecup"`
	CicloImoveis  []int                 `json:"cicloImoveis"`
	PendBairros   []string              `json:"pendBairros"`
	PendValores   []float64             `json:"pendValores"`
	HCampoImoveis []int                 `json:"hCampoImoveis"`
	HCampoSemRec  []float64             `json:"hCampoSemRec"`
	HCampoRecup   []float64             `json:"hCampoRecup"`
	Pontos        []BiEpiPonto          `json:"pontos"`
}

type BiEpiData struct {
	Ano                                                            int
	Hoje                                                           string
	Doenca                                                         int64
	NomeDoenca                                                     string
	Anos, Opcoes                                                   []CidadeOpcao
	Total, Confirmados, Descartados, Inconclusivos, EmInvestigacao int
	Doencas                                                        []BiEpiDoenca
	Titulo, Subtitulo, GrupoCampo                                  string
	KPIsEpi, KPIsEnt                                               []BiEpiKpi
	Insights                                                       []string
	Oport                                                          BiEpiOport
	Ciclos                                                         []BiEpiCiclo
	Anos4                                                          []BiEpiAno
	BairrosAtencao                                                 []BiEpiBairro
	Graficos                                                       BiEpiGraficos
}

// TaxaConfirmacao é confirmados ÷ casos com resultado definido, em %.
func (d BiEpiData) TaxaConfirmacao() string {
	return razao(d.Confirmados, d.Confirmados+d.Descartados+d.Inconclusivos)
}

func f1(v float64) string { return strconv.FormatFloat(v, 'f', 1, 64) + "%" }

func biEpiPct(parte, total int) string { return razao(parte, total) }

templ biEpiKpis(itens []BiEpiKpi, entomologia bool) {
	<div class={ "bie-kpis", templ.KV("bie-ent", entomologia) }>
		for _, k := range itens {
			<div class="bie-kpi">
				<span class="bie-kpi-l">{ k.Rotulo }</span>
				<strong class="bie-kpi-v">{ k.Valor }</strong>
				<span class="bie-kpi-d">{ k.Detalhe }</span>
			</div>
		}
	</div>
}

templ BiEpi(l Layout, d BiEpiData) {
	@Base(l) {
		<link rel="stylesheet" href={ asset("/static/css/bi_epi.css") }/>
		<div class="bie" id="bie">
			@PageHeader("B.I. Epidemiológico", "Casos investigados e trabalho de campo, no mesmo painel.")
			<form method="get" action="/bi-epidemiologico" class="cartao filtros bie-filtros">
				<label class="campo">
					<span>Ano</span>
					<select name="ano" onchange="this.form.submit()">
						for _, o := range d.Anos {
							<option value={ strconv.FormatInt(o.ID, 10) } selected?={ o.Selecionada }>{ o.Rotulo }</option>
						}
					</select>
				</label>
				<label class="campo">
					<span>Doença</span>
					<select name="doenca" onchange="this.form.submit()">
						<option value="">Todas</option>
						for _, o := range d.Opcoes {
							<option value={ strconv.FormatInt(o.ID, 10) } selected?={ o.Selecionada }>{ o.Rotulo }</option>
						}
					</select>
				</label>
			</form>
			<div class="bie-abas seg" role="tablist" aria-label="Seções">
				<button type="button" data-aba="resumo" aria-pressed="true">Resumo</button>
				<button type="button" data-aba="epidemiologia" aria-pressed="false">Epidemiologia</button>
				<button type="button" data-aba="historico" aria-pressed="false">Histórico de casos</button>
				<button type="button" data-aba="entomologia" aria-pressed="false">Entomologia</button>
				<button type="button" data-aba="hcampo" aria-pressed="false">Histórico de campo</button>
				<button type="button" data-aba="cruzamento" aria-pressed="false">Cruzamento por bairro</button>
				<button type="button" data-aba="notas" aria-pressed="false">Fontes e limites</button>
			</div>
			<section class="bie-view on" id="bie-resumo">
				<div class="bie-hero">
					<div>
						<p class="bie-eyebrow">Situação de { strconv.Itoa(d.Ano) }</p>
						<h2>{ d.Titulo }</h2>
						<p class="bie-hs">{ d.Subtitulo }</p>
					</div>
					<div class="bie-spark">
						<p class="bie-ttl">Investigações por semana epidemiológica</p>
						<div id="bie-spark"></div>
					</div>
				</div>
				<p class="bie-grp"><i></i>Epidemiologia · investigações</p>
				@biEpiKpis(d.KPIsEpi, false)
				if len(d.KPIsEnt) > 0 {
					<p class="bie-grp bie-grp-ent"><i></i>{ d.GrupoCampo }</p>
					@biEpiKpis(d.KPIsEnt, true)
				}
				if len(d.Insights) > 0 {
					<h3 class="bie-h">Leitura rápida</h3>
					<ul class="bie-insights">
						for _, t := range d.Insights {
							<li>@templ.Raw(t)</li>
						}
					</ul>
				}
				<div class="bie-grid2">
					<div class="bie-panel">
						<h3 class="bie-h">Investigações por semana epidemiológica</h3>
						<p class="bie-sub">Semana de início, por resultado.</p>
						<div id="bie-sem1"></div>
					</div>
					<div class="bie-panel">
						<h3 class="bie-h">Todas as doenças investigadas</h3>
						<p class="bie-sub">Casos com início em { strconv.Itoa(d.Ano) }, até { d.Hoje }.</p>
						<div class="bie-tablewrap">
							<table class="bie-tab">
								<thead>
									<tr>
										<th>Doença / agravo</th>
										<th>Total</th>
										<th>Confirmados</th>
										<th>Descartados</th>
										<th>Inconclusivos</th>
										<th>Em investigação</th>
										<th>Confirmação</th>
									</tr>
								</thead>
								<tbody>
									if len(d.Doencas) == 0 {
										<tr><td colspan="7">Nenhuma investigação com início no período.</td></tr>
									}
									for _, x := range d.Doencas {
										<tr>
											<td>{ x.Nome }</td>
											<td>{ strconv.Itoa(x.Total) }</td>
											<td>{ strconv.Itoa(x.Confirmados) }</td>
											<td>{ strconv.Itoa(x.Descartados) }</td>
											<td>{ strconv.Itoa(x.Inconclusivos) }</td>
											<td>{ strconv.Itoa(x.EmInvestigacao) }</td>
											<td>{ biEpiPct(x.Confirmados, x.Confirmados+x.Descartados+x.Inconclusivos) }</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					</div>
				</div>
			</section>
			<section class="bie-view" id="bie-epidemiologia">
				<header class="bie-pagehead">
					<p class="bie-eyebrow">Epidemiologia</p>
					<h2>Investigações em { strconv.Itoa(d.Ano) }</h2>
					<p class="bie-lede">Casos com data de início de 01/01 a { d.Hoje }. Confirmado é o resultado positivo.</p>
				</header>
				<div class="bie-panel">
					<h3 class="bie-h">Curva de investigações</h3>
					<p class="bie-sub">Por semana epidemiológica de início; a linha mostra os confirmados.</p>
					<div id="bie-curva"></div>
				</div>
				<div class="bie-panel">
					<h3 class="bie-h">Bairros com mais casos</h3>
					<p class="bie-sub">Só as investigações ligadas a um local têm bairro; as demais ficam em "Sem bairro".</p>
					<div id="bie-bairros"></div>
				</div>
				<div class="bie-grid2">
					<div class="bie-panel">
						<h3 class="bie-h">Resultado das investigações</h3>
						<p class="bie-sub">Como os casos do período foram classificados.</p>
						<div id="bie-resultado"></div>
					</div>
					<div class="bie-panel">
						<h3 class="bie-h">Oportunidade</h3>
						<p class="bie-sub">Situação das investigações e tempo até o encerramento.</p>
						<div class="bie-kpis bie-kpis-p">
							<div class="bie-kpi"><span class="bie-kpi-l">Encerradas</span><strong class="bie-kpi-v">{ strconv.Itoa(d.Oport.Encerradas) }</strong><span class="bie-kpi-d">{ biEpiPct(d.Oport.Encerradas, d.Oport.Total) } do total</span></div>
							<div class="bie-kpi"><span class="bie-kpi-l">Mediana até encerrar</span><strong class="bie-kpi-v">{ d.Oport.Mediana } dias</strong><span class="bie-kpi-d">{ strconv.Itoa(d.Oport.ComTempo) } com data de encerramento</span></div>
							<div class="bie-kpi"><span class="bie-kpi-l">Até 7 dias</span><strong class="bie-kpi-v">{ biEpiPct(d.Oport.Ate7, d.Oport.ComTempo) }</strong><span class="bie-kpi-d">{ strconv.Itoa(d.Oport.Ate7) } encerradas</span></div>
							<div class="bie-kpi"><span class="bie-kpi-l">Até 30 dias</span><strong class="bie-kpi-v">{ biEpiPct(d.Oport.Ate30, d.Oport.ComTempo) }</strong><span class="bie-kpi-d">{ strconv.Itoa(d.Oport.Ate30) } encerradas</span></div>
							<div class="bie-kpi"><span class="bie-kpi-l">Em atendimento</span><strong class="bie-kpi-v">{ strconv.Itoa(d.Oport.EmAtendimento) }</strong><span class="bie-kpi-d">{ strconv.Itoa(d.Oport.Aguardando) } aguardando início</span></div>
						</div>
						<p class="bie-sub bie-nota">Sexo, faixa etária e laboratório ainda não são registrados nas investigações; entram quando a ficha passar a guardá-los.</p>
					</div>
				</div>
			</section>
			<section class="bie-view" id="bie-historico">
				<header class="bie-pagehead">
					<p class="bie-eyebrow">Histórico de casos</p>
					<h2>Quatro anos de investigações</h2>
					<p class="bie-lede">De { strconv.Itoa(d.Ano - 3) } a { strconv.Itoa(d.Ano) }, pela data de início.</p>
				</header>
				<div class="bie-grid2">
					<div class="bie-panel">
						<h3 class="bie-h">Mesmo período, 01/01 a { d.Hoje[:5] }</h3>
						<p class="bie-sub">Investigações e confirmados em cada ano até o mesmo dia.</p>
						<div id="bie-hmp"></div>
					</div>
					<div class="bie-panel">
						<div class="bie-phead">
							<div>
								<h3 class="bie-h">Curva mensal por ano</h3>
								<p class="bie-sub">Os quatro anos sobrepostos.</p>
							</div>
							<div class="seg">
								<button id="bie-hm-c" type="button" aria-pressed="true">Confirmados</button>
								<button id="bie-hm-n" type="button" aria-pressed="false">Investigações</button>
							</div>
						</div>
						<div id="bie-hmes"></div>
					</div>
				</div>
				<div class="bie-panel">
					<h3 class="bie-h">Quatro anos em números</h3>
					<div class="bie-tablewrap">
						<table class="bie-tab">
							<thead>
								<tr>
									<th>Ano</th>
									<th>Investigações</th>
									<th>Confirmados</th>
									<th>Descartados</th>
									<th>Confirmação</th>
								</tr>
							</thead>
							<tbody>
								for _, a := range d.Anos4 {
									<tr>
										<td>{ strconv.Itoa(a.Ano) }</td>
										<td>{ strconv.Itoa(a.Notificados) }</td>
										<td>{ strconv.Itoa(a.Confirmados) }</td>
										<td>{ strconv.Itoa(a.Descartados) }</td>
										<td>{ biEpiPct(a.Confirmados, a.Notificados) }</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				</div>
			</section>
			<section class="bie-view" id="bie-entomologia">
				<header class="bie-pagehead">
					<p class="bie-eyebrow bie-eyebrow-ent">Entomologia</p>
					<h2>Produção de campo por ciclo, { strconv.Itoa(d.Ano) }</h2>
					<p class="bie-lede">Imóveis visitados, fechados e recuperados em cada ciclo que começa no ano. Fechado sem recuperação é o imóvel encontrado fechado e que não foi trabalhado depois, no mesmo ciclo.</p>
				</header>
				<div class="bie-grid2">
					<div class="bie-panel">
						<h3 class="bie-h">Evolução por ciclo</h3>
						<p class="bie-sub">Percentual de fechados sem recuperação e de recuperação dos fechados.</p>
						<div id="bie-evol"></div>
					</div>
					<div class="bie-panel">
						<h3 class="bie-h">Imóveis visitados por ciclo</h3>
						<p class="bie-sub">Cresce com o cadastro de imóveis.</p>
						<div id="bie-imoveis"></div>
					</div>
				</div>
				<div class="bie-panel">
					<h3 class="bie-h">Todos os ciclos de { strconv.Itoa(d.Ano) }</h3>
					<div class="bie-tablewrap">
						<table class="bie-tab">
							<thead>
								<tr>
									<th>Ciclo</th>
									<th>Visitas</th>
									<th>Imóveis</th>
									<th>Fechados</th>
									<th>Recuperados</th>
									<th>Fechados sem recuperação</th>
									<th>% sem recuperação</th>
									<th>Imóveis positivos</th>
								</tr>
							</thead>
							<tbody>
								if len(d.Ciclos) == 0 {
									<tr><td colspan="8">Nenhuma visita nos ciclos deste ano.</td></tr>
								}
								for _, c := range d.Ciclos {
									<tr>
										<td>{ c.Nome }</td>
										<td>{ strconv.Itoa(c.Visitas) }</td>
										<td>{ strconv.Itoa(c.Imoveis) }</td>
										<td>{ strconv.Itoa(c.Fechados) }</td>
										<td>{ strconv.Itoa(c.Recuperados) }</td>
										<td>{ strconv.Itoa(c.SemRec) }</td>
										<td>{ biEpiPct(c.SemRec, c.Imoveis) }</td>
										<td>{ strconv.Itoa(c.Positivos) }</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				</div>
				<div class="bie-panel">
					<h3 class="bie-h">Bairros com mais imóveis fechados sem recuperação</h3>
					<p class="bie-sub">Os 15 maiores percentuais no ano, sobre os imóveis visitados do bairro.</p>
					<div id="bie-pend"></div>
				</div>
			</section>
			<section class="bie-view" id="bie-hcampo">
				<header class="bie-pagehead">
					<p class="bie-eyebrow bie-eyebrow-ent">Histórico de campo</p>
					<h2>Quatro anos de visitas de campo</h2>
					<p class="bie-lede">Totais dos ciclos que começam em cada ano, de { strconv.Itoa(d.Ano - 3) } a { strconv.Itoa(d.Ano) }.</p>
				</header>
				<div class="bie-grid2">
					<div class="bie-panel">
						<h3 class="bie-h">Fechados sem recuperação</h3>
						<p class="bie-sub">Percentual dos imóveis visitados que continuaram fechados.</p>
						<div id="bie-hc-sem"></div>
					</div>
					<div class="bie-panel">
						<h3 class="bie-h">Recuperação dos fechados</h3>
						<p class="bie-sub">Percentual dos fechados que foram trabalhados depois.</p>
						<div id="bie-hc-rec"></div>
					</div>
				</div>
				<div class="bie-panel">
					<h3 class="bie-h">Quatro anos em números</h3>
					<div class="bie-tablewrap">
						<table class="bie-tab">
							<thead>
								<tr>
									<th>Ano</th>
									<th>Visitas</th>
									<th>Imóveis</th>
									<th>Fechados</th>
									<th>Recuperados</th>
									<th>Sem recuperação</th>
									<th>% sem recuperação</th>
									<th>Positivos</th>
								</tr>
							</thead>
							<tbody>
								for _, a := range d.Anos4 {
									<tr>
										<td>{ strconv.Itoa(a.Ano) }</td>
										<td>{ strconv.Itoa(a.Visitas) }</td>
										<td>{ strconv.Itoa(a.Imoveis) }</td>
										<td>{ strconv.Itoa(a.Fechados) }</td>
										<td>{ strconv.Itoa(a.Recuperados) }</td>
										<td>{ strconv.Itoa(a.SemRec) }</td>
										<td>{ f1(a.PctSemRec) }</td>
										<td>{ strconv.Itoa(a.Positivos) }</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				</div>
			</section>
			<section class="bie-view" id="bie-cruzamento">
				<header class="bie-pagehead">
					<p class="bie-eyebrow">Casos e campo</p>
					<h2>Casos e campo no mesmo bairro</h2>
					<p class="bie-lede">Cada ponto é um bairro. Eixo horizontal: investigações; eixo vertical: percentual de imóveis fechados sem recuperação. Só entram bairros com casos ligados a um local e com visitas no ano.</p>
				</header>
				<div class="bie-panel">
					<div id="bie-scatter"></div>
				</div>
				<h3 class="bie-h">Bairros para atenção</h3>
				<div class="bie-ctl">
					<label>Casos (mín.)<input id="bie-f-casos" type="number" min="0" value="1"/></label>
					<label>e fechados sem recuperação (mín. %)<input id="bie-f-pend" type="number" min="0" step="0.5" value="0"/></label>
					<label>Buscar bairro<input id="bie-f-q" type="search" placeholder="Nome do bairro"/></label>
					<span class="bie-sub" id="bie-f-count"></span>
				</div>
				<div class="bie-tablewrap bie-rolagem">
					<table class="bie-tab" id="bie-t-bairros">
						<thead>
							<tr>
								<th>Bairro</th>
								<th>Casos</th>
								<th>Confirmados</th>
								<th>Imóveis visitados</th>
								<th>% sem recuperação</th>
							</tr>
						</thead>
						<tbody>
							for _, b := range d.BairrosAtencao {
								<tr data-nome={ b.Bairro } data-casos={ strconv.Itoa(b.Casos) } data-pend={ strconv.FormatFloat(b.PctSemRec, 'f', 1, 64) }>
									<td>{ b.Bairro }</td>
									<td>{ strconv.Itoa(b.Casos) }</td>
									<td>{ strconv.Itoa(b.Confirmados) }</td>
									<td>{ strconv.Itoa(b.Imoveis) }</td>
									if b.PctSemRec < 0 {
										<td>—</td>
									} else {
										<td>{ f1(b.PctSemRec) }</td>
									}
								</tr>
							}
						</tbody>
					</table>
				</div>
			</section>
			<section class="bie-view" id="bie-notas">
				<header class="bie-pagehead">
					<p class="bie-eyebrow">Transparência</p>
					<h2>Fontes e limites</h2>
					<p class="bie-lede">De onde vêm os números e o que eles ainda não mostram.</p>
				</header>
				<dl class="bie-notes">
					<div class="bie-nc"><dt>Casos</dt><dd>Investigações cadastradas no sistema, contadas pela data de início. Confirmado é o resultado positivo, descartado o negativo; a taxa de confirmação usa só os casos com resultado definido. Investigações sem data de início ficam fora do período.</dd></div>
					<div class="bie-nc"><dt>Semana epidemiológica</dt><dd>Calculada pelo padrão escolhido nos Parâmetros (SINAN ou ISO), a partir da data de início da investigação.</dd></div>
					<div class="bie-nc"><dt>Bairro</dt><dd>Só existe quando a investigação está ligada a um local. As importadas só trazem o endereço em texto e aparecem como "Sem bairro", por isso o cruzamento por bairro mostra menos casos que o total.</dd></div>
					<div class="bie-nc"><dt>Campo</dt><dd>Visitas dos ciclos que começam no ano. Imóvel é o local visitado no ciclo; fechado é o que teve visita com pendência "fechado"; recuperado, o fechado que depois foi trabalhado; sem recuperação, o fechado sem nenhuma visita trabalhada no ciclo.</dd></div>
					<div class="bie-nc"><dt>O que ainda não existe</dt><dd>Sexo, faixa etária, laboratório (exames e sorotipos), hospitalização, óbitos, bloqueios e a comparação com o SisPNCD não são registrados aqui. Entram quando essas informações passarem a ser guardadas.</dd></div>
				</dl>
			</section>
			@templ.JSONScript("bie-dados", d.Graficos)
			<script src={ asset("/static/vendor/apexcharts.min.js") }></script>
			<script src={ asset("/static/js/bi_epi.js") }></script>
		</div>
	}
}
