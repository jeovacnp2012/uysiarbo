package views

import "strconv"

// ---- Cidades ----

templ Cidades(l Layout, linhas []CidadeLinha, podeEditar bool) {
	@Base(l) {
		@PageHeader("Cidades", "Os municípios atendidos neste ambiente. Os bairros pertencem a uma cidade.") {
			if podeEditar {
				<a class="btn btn-primario" href="/cidades/nova">Nova cidade</a>
			}
		}
		<section class="cartao">
			<div class="tabela-wrap">
				<table class="tabela">
					<thead>
						<tr>
							<th scope="col">Cidade</th>
							<th scope="col">UF</th>
							<th scope="col">Código IBGE</th>
							<th scope="col">Bairros</th>
							<th scope="col">Situação</th>
							<th scope="col"><span class="sr-only">Ações</span></th>
						</tr>
					</thead>
					<tbody>
						for _, c := range linhas {
							<tr>
								<td data-rotulo="Cidade"><strong>{ c.Nome }</strong></td>
								<td data-rotulo="UF">{ c.UF }</td>
								<td data-rotulo="Código IBGE">{ c.IBGE }</td>
								<td data-rotulo="Bairros">{ strconv.Itoa(c.Bairros) }</td>
								<td data-rotulo="Situação">
									if c.Ativo {
										<span class="selo selo-ok">Ativa</span>
									} else {
										<span class="selo selo-aviso">Inativa</span>
									}
								</td>
								<td data-rotulo="Ações"><a class="btn" href={ templ.SafeURL("/cidades/" + strconv.FormatInt(c.ID, 10)) }>Abrir</a></td>
							</tr>
						}
					</tbody>
				</table>
				if len(linhas) == 0 {
					<div class="tabela-vazia">Nenhuma cidade cadastrada. Cadastre a primeira para poder criar bairros.</div>
				}
			</div>
		</section>
	}
}

templ CidadeForm(l Layout, d CidadeFormData) {
	@Base(l) {
		if d.Novo() {
			@PageHeader("Nova cidade", "") {
				<a class="btn" href="/cidades">Voltar</a>
			}
		} else {
			@PageHeader("Cidade", d.Nome) {
				<a class="btn" href="/cidades">Voltar</a>
			}
			@Presenca("cidade", strconv.FormatInt(d.ID, 10), modoDaTela(d.PodeEditar))
		}
		<form
			method="post"
			if d.Novo() {
				action="/cidades"
			} else {
				action={ templ.SafeURL("/cidades/" + strconv.FormatInt(d.ID, 10)) }
			}
			class="cartao form-admin"
		>
			<input type="hidden" name="csrf" value={ d.CSRF }/>
			if d.Erro != "" {
				<p class="alerta alerta-erro" role="alert">{ d.Erro }</p>
			}
			<fieldset class="sem-borda" disabled?={ !d.PodeEditar }>
				<div class="campo">
					<label for="nome">Nome da cidade</label>
					<input id="nome" name="nome" type="text" value={ d.Nome } maxlength="100" required/>
				</div>
				<div class="campo">
					<label for="uf">UF (sigla do estado)</label>
					<input id="uf" name="uf" type="text" value={ d.UF } maxlength="2" pattern="[A-Za-z]{2}" placeholder="MT" required/>
				</div>
				<div class="campo">
					<label for="ibge">Código IBGE do município (7 dígitos, opcional)</label>
					<input id="ibge" name="ibge" type="text" value={ d.IBGE } maxlength="7" inputmode="numeric"/>
				</div>
				if !d.Novo() {
					<label class="marcar">
						<input type="checkbox" name="ativo" value="1" checked?={ d.Ativo }/>
						Cidade ativa (pode receber novos bairros)
					</label>
				}
			</fieldset>
			if d.PodeEditar {
				<div class="form-acoes">
					<button type="submit" class="btn btn-primario">Salvar</button>
					<a class="btn" href="/cidades">Cancelar</a>
				</div>
			}
		</form>
	}
}

// ---- Bairros ----

templ Bairros(l Layout, d BairrosData) {
	@Base(l) {
		@PageHeader("Bairros", "Bairros e povoados, com responsáveis e quarteirões.") {
			if d.PodeEditar {
				<a class="btn btn-primario" href="/bairros/novo">Novo bairro</a>
			}
		}
		if d.Restrito {
			<p class="alerta alerta-aviso" role="status">O seu papel mostra apenas os bairros atribuídos a você.</p>
		}
		<form method="get" action="/bairros" class="cartao filtros">
			<div class="campo">
				<label for="f-busca">Nome do bairro</label>
				<input id="f-busca" name="busca" type="search" value={ d.Filtro.Busca }/>
			</div>
			<div class="campo">
				<label for="f-cidade">Cidade</label>
				<select id="f-cidade" name="cidade">
					<option value="">Todas</option>
					for _, c := range d.Cidades {
						<option value={ strconv.FormatInt(c.ID, 10) } selected?={ c.Selecionada }>{ c.Rotulo }</option>
					}
				</select>
			</div>
			<div class="campo">
				<label for="f-status">Situação</label>
				<select id="f-status" name="status">
					<option value="">Todas</option>
					<option value="ativo" selected?={ d.Filtro.Status == "ativo" }>Ativo</option>
					<option value="extinto" selected?={ d.Filtro.Status == "extinto" }>Extinto</option>
				</select>
			</div>
			<div class="campo">
				<label for="f-categoria">Categoria</label>
				<select id="f-categoria" name="categoria">
					<option value="">Todas</option>
					<option value="bairro" selected?={ d.Filtro.Categoria == "bairro" }>Bairro</option>
					<option value="povoado" selected?={ d.Filtro.Categoria == "povoado" }>Povoado</option>
				</select>
			</div>
			<div class="form-acoes">
				<button type="submit" class="btn btn-primario">Filtrar</button>
				<a class="btn" href="/bairros">Limpar</a>
			</div>
		</form>
		<section class="cartao">
			<div class="tabela-wrap">
				<table class="tabela">
					<thead>
						<tr>
							<th scope="col">Bairro</th>
							<th scope="col">Responsáveis</th>
							<th scope="col">Mutirão</th>
							<th scope="col">Quarteirões</th>
							<th scope="col">Situação</th>
							<th scope="col"><span class="sr-only">Ações</span></th>
						</tr>
					</thead>
					<tbody>
						for _, b := range d.Linhas {
							<tr>
								<td data-rotulo="Bairro">
									<strong>{ b.Nome }</strong>
									<div class="subtitulo">{ b.Cidade } · { b.Categoria } · { b.Classificacao }</div>
								</td>
								<td data-rotulo="Responsáveis">
									if b.Responsaveis == "" {
										<span class="subtitulo">sem responsável</span>
									} else {
										{ b.Responsaveis }
									}
								</td>
								<td data-rotulo="Mutirão">
									if b.Mutirao {
										sim
									} else {
										não
									}
								</td>
								<td data-rotulo="Quarteirões">{ strconv.Itoa(b.Quarteiroes) }</td>
								<td data-rotulo="Situação">
									if b.Status == "ativo" {
										<span class="selo selo-ok">Ativo</span>
									} else {
										<span class="selo selo-aviso">Extinto</span>
									}
								</td>
								<td data-rotulo="Ações"><a class="btn" href={ templ.SafeURL("/bairros/" + strconv.FormatInt(b.ID, 10)) }>Abrir</a></td>
							</tr>
						}
					</tbody>
				</table>
				if len(d.Linhas) == 0 {
					<div class="tabela-vazia">Nenhum bairro encontrado.</div>
				}
			</div>
			<div class="paginacao">
				<span>{ d.Pag.Summary() } · página { strconv.Itoa(d.Pag.Page) } de { strconv.Itoa(d.Pag.Pages()) }</span>
				<div class="paginacao-botoes">
					<a class="btn" href={ templ.SafeURL(pageURL("/bairros", d.Query, d.Pag.Page-1)) } aria-disabled?={ !d.Pag.HasPrev() }>← Anterior</a>
					<a class="btn" href={ templ.SafeURL(pageURL("/bairros", d.Query, d.Pag.Page+1)) } aria-disabled?={ !d.Pag.HasNext() }>Próxima →</a>
				</div>
			</div>
		</section>
	}
}

templ opcoesSimples(atual string, valores [][2]string) {
	for _, v := range valores {
		<option value={ v[0] } selected?={ atual == v[0] }>{ v[1] }</option>
	}
}

templ BairroForm(l Layout, d BairroFormData) {
	@Base(l) {
		if d.Novo() {
			@PageHeader("Novo bairro", "Depois de salvar, você cadastra os quarteirões.") {
				<a class="btn" href="/bairros">Voltar</a>
			}
		} else {
			@PageHeader("Bairro", d.Nome) {
				<a class="btn" href="/bairros">Voltar</a>
			}
			@Presenca("bairro", strconv.FormatInt(d.ID, 10), modoDaTela(d.PodeEditar))
		}
		if d.Aviso != "" {
			<p class="alerta alerta-ok" role="status">{ d.Aviso }</p>
		}
		<form
			method="post"
			if d.Novo() {
				action="/bairros"
			} else {
				action={ templ.SafeURL("/bairros/" + strconv.FormatInt(d.ID, 10)) }
			}
			class="cartao form-admin"
		>
			<input type="hidden" name="csrf" value={ d.CSRF }/>
			if d.Erro != "" {
				<p class="alerta alerta-erro" role="alert">{ d.Erro }</p>
			}
			if len(d.Cidades) == 0 {
				<p class="alerta alerta-aviso">Nenhuma cidade ativa cadastrada. <a href="/cidades/nova">Cadastre uma cidade</a> antes de criar bairros.</p>
			}
			<fieldset class="sem-borda" disabled?={ !d.PodeEditar }>
				<div class="campo">
					<label for="nome">Nome</label>
					<input id="nome" name="nome" type="text" value={ d.Nome } maxlength="120" required/>
				</div>
				<div class="campo">
					<label for="cidade">Cidade</label>
					<select id="cidade" name="cidade_id" required>
						for _, c := range d.Cidades {
							<option value={ strconv.FormatInt(c.ID, 10) } selected?={ c.Selecionada }>{ c.Rotulo }</option>
						}
					</select>
				</div>
				<div class="grade-form">
					<div class="campo">
						<label for="status">Situação</label>
						<select id="status" name="status">
							@opcoesSimples(d.Status, [][2]string{{"ativo", "Ativo"}, {"extinto", "Extinto"}})
						</select>
					</div>
					<div class="campo">
						<label for="categoria">Categoria</label>
						<select id="categoria" name="categoria">
							@opcoesSimples(d.Categoria, [][2]string{{"bairro", "Bairro"}, {"povoado", "Povoado"}})
						</select>
					</div>
					<div class="campo">
						<label for="classificacao">Classificação</label>
						<select id="classificacao" name="classificacao">
							@opcoesSimples(d.Classificacao, [][2]string{{"urbano", "Urbano"}, {"rural", "Rural"}})
						</select>
					</div>
					<div class="campo">
						<label for="zona">Zona</label>
						<input id="zona" name="zona" type="text" value={ d.Zona } maxlength="30"/>
					</div>
					<div class="campo">
						<label for="ibge">Código IBGE</label>
						<input id="ibge" name="ibge" type="text" value={ d.Ibge } maxlength="20"/>
					</div>
					<div class="campo">
						<label for="distancia">Distância do centro (km)</label>
						<input id="distancia" name="distancia_centro" type="text" value={ d.Distancia } inputmode="decimal"/>
					</div>
					<div class="campo">
						<label for="latitude">Latitude</label>
						<input id="latitude" name="latitude" type="text" value={ d.Latitude } inputmode="decimal" placeholder="-13.8247"/>
					</div>
					<div class="campo">
						<label for="longitude">Longitude</label>
						<input id="longitude" name="longitude" type="text" value={ d.Longitude } inputmode="decimal" placeholder="-56.0813"/>
					</div>
					<div class="campo">
						<label for="altitude">Altitude (m)</label>
						<input id="altitude" name="altitude" type="text" value={ d.Altitude } inputmode="decimal"/>
					</div>
				</div>
				<label class="marcar">
					<input type="checkbox" name="mutirao" value="1" checked?={ d.Mutirao }/>
					Bairro de mutirão
				</label>
				<label class="marcar">
					<input type="checkbox" name="producao" value="1" checked?={ d.Producao }/>
					Entra no relatório de produção
				</label>

				<h2>Responsáveis</h2>
				<p class="subtitulo">Quem responde por este bairro. Quem tem a permissão "apenas atribuídos" só enxerga os bairros em que está marcado aqui.</p>
				<div class="grade-marcar">
					for _, r := range d.Responsaveis {
						<label class="marcar">
							<input type="checkbox" name="responsavel" value={ strconv.FormatInt(r.ID, 10) } checked?={ r.Marcado }/>
							<span>{ r.Nome } <span class="subtitulo">{ r.Email }</span></span>
						</label>
					}
					if len(d.Responsaveis) == 0 {
						<span class="subtitulo">Nenhum usuário ativo.</span>
					}
				</div>
			</fieldset>
			if d.PodeEditar {
				<div class="form-acoes">
					<button type="submit" class="btn btn-primario">Salvar bairro</button>
					<a class="btn" href="/bairros">Cancelar</a>
				</div>
			}
		</form>
		if !d.Novo() {
			<section class="cartao form-admin" id="limite">
				<h2>Limite no mapa</h2>
				if d.ErroLimite != "" {
					<p class="alerta alerta-erro" role="alert">{ d.ErroLimite }</p>
				}
				if d.Limite != nil {
					<p class="subtitulo">Polígono gravado: <strong>{ d.Limite.AreaHa } ha</strong>, ponto interno {d.Limite.Latitude}, {d.Limite.Longitude}.</p>
				} else {
					<p class="subtitulo">Este bairro ainda não tem limite no mapa.</p>
				}
				if d.PodeEditar {
					<form method="post" action={ templ.SafeURL("/bairros/" + strconv.FormatInt(d.ID, 10) + "/limite") } class="form-admin">
						<input type="hidden" name="csrf" value={ d.CSRF }/>
						<div class="campo">
							<label for="geojson">GeoJSON do bairro (um polígono, em longitude/latitude)</label>
							<textarea id="geojson" name="geojson" rows="5" spellcheck="false" placeholder={ `{"type":"Polygon","coordinates":[[[-56.09,-13.83],[-56.07,-13.83],[-56.07,-13.81],[-56.09,-13.83]]]}` }>{ d.GeoJSONTexto }</textarea>
						</div>
						<div class="form-acoes">
							<button type="submit" name="acao" value="salvar" class="btn btn-primario">
								if d.Limite != nil {
									Substituir limite
								} else {
									Gravar limite
								}
							</button>
							if d.Limite != nil {
								<button type="submit" name="acao" value="remover" class="btn">Remover limite</button>
							}
						</div>
					</form>
				}
			</section>
			<section class="cartao form-admin" id="quarteiroes">
				<h2>Quarteirões <span class="selo">{ strconv.Itoa(len(d.Quarteiroes)) }</span></h2>
				if d.PodeEditar {
					<form method="post" action={ templ.SafeURL("/bairros/" + strconv.FormatInt(d.ID, 10) + "/quarteiroes") } class="form-admin">
						<input type="hidden" name="csrf" value={ d.CSRF }/>
						<div class="campo">
							<label for="novos">Novos quarteirões (um por linha, ou uma faixa como 1-20)</label>
							<textarea id="novos" name="nomes" rows="3" placeholder={ "1-20" + "\n" + "A1" }></textarea>
						</div>
						<div class="form-acoes">
							<button type="submit" class="btn btn-primario">Adicionar quarteirões</button>
						</div>
					</form>
					<form method="post" action={ templ.SafeURL("/bairros/" + strconv.FormatInt(d.ID, 10) + "/quarteiroes/limites") } class="form-admin">
						<input type="hidden" name="csrf" value={ d.CSRF }/>
						<div class="campo">
							<label for="geojson-q">Importar limites dos quarteirões (FeatureCollection; cada polígono com a propriedade "nome")</label>
							<textarea id="geojson-q" name="geojson" rows="3" spellcheck="false"></textarea>
						</div>
						<div class="form-acoes">
							<button type="submit" class="btn">Importar limites</button>
						</div>
					</form>
				}
				<div class="grade-quarteiroes">
					for _, q := range d.Quarteiroes {
						<div class={ "quarteirao", templ.KV("quarteirao-inativo", !q.Ativo) }>
							<strong>{ q.Nome }</strong>
							if q.ComLimite {
								<span class="selo">no mapa</span>
							}
							if d.PodeEditar {
								<form method="post" action={ templ.SafeURL("/bairros/" + strconv.FormatInt(d.ID, 10) + "/quarteiroes/" + strconv.FormatInt(q.ID, 10) + "/ativo") } class="inline">
									<input type="hidden" name="csrf" value={ d.CSRF }/>
									if q.Ativo {
										<input type="hidden" name="ativo" value="0"/>
										<button type="submit" class="btn btn-icone" aria-label={ "Desativar o quarteirão " + q.Nome }>Desativar</button>
									} else {
										<input type="hidden" name="ativo" value="1"/>
										<button type="submit" class="btn btn-icone" aria-label={ "Reativar o quarteirão " + q.Nome }>Reativar</button>
									}
								</form>
							} else if !q.Ativo {
								<span class="selo selo-aviso">inativo</span>
							}
						</div>
					}
				</div>
				if len(d.Quarteiroes) == 0 {
					<div class="tabela-vazia">Nenhum quarteirão cadastrado neste bairro.</div>
				}
			</section>
		}
	}
}
