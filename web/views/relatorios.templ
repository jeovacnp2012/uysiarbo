package views

import "strconv"

type RelatorioItem struct{ Slug, Titulo, Resumo string }

type RelatoriosIndice struct{ Itens []RelatorioItem }

// RelatorioCampo é um filtro do formulário do relatório; Opcoes só vale para os tipos de lista.
type RelatorioCampo struct {
	Nome, Rotulo, Tipo, Valor string
	Opcoes                    []CidadeOpcao
}

type RelatorioTela struct {
	Slug, Titulo, Resumo string
	Campos               []RelatorioCampo
	Gerado, Cortado      bool
	Colunas              []string
	Linhas               [][]string
	Totais               []string
	Total, Mostradas     int
	Query                string
}

// iconeDoCampo escolhe o ícone do rótulo de um filtro pelo tipo dele.
func iconeDoCampo(tipo string) string {
	switch tipo {
	case "ciclo":
		return "repeat"
	case "atividade":
		return "activity"
	case "agente":
		return "user"
	case "bairro":
		return "building"
	case "data":
		return "calendar"
	case "pendencia":
		return "alert"
	case "simnao":
		return "droplet"
	case "tipolocal":
		return "pin"
	}
	return "sliders"
}

func valorOpcao(o CidadeOpcao) string {
	if o.Valor != "" {
		return o.Valor
	}
	return strconv.FormatInt(o.ID, 10)
}

templ Relatorios(l Layout, d RelatoriosIndice) {
	@Base(l) {
		@PageHeader("Relatórios", "Escolha um relatório, ajuste os filtros e veja na tela ou baixe em PDF, planilha ou CSV.")
		if len(d.Itens) == 0 {
			<p class="cartao">Você não tem permissão para nenhum relatório.</p>
		}
		<div class="grade-cartoes">
			for _, i := range d.Itens {
				<a class="cartao rel-cartao" href={ templ.SafeURL("/relatorios/" + i.Slug) }>
					<strong data-ico="chart">{ i.Titulo }</strong>
					<p class="subtitulo">{ i.Resumo }</p>
				</a>
			}
		</div>
	}
}

templ RelatorioPagina(l Layout, d RelatorioTela) {
	@Base(l) {
		@PageHeader(d.Titulo, d.Resumo)
		<form method="get" action={ templ.SafeURL("/relatorios/" + d.Slug) } class="cartao rel-form" data-gaveta-aberta?={ !d.Gerado }>
			<h2 class="rel-titulo" data-ico="sliders">Filtros</h2>
			<div class="rel-campos">
			for _, c := range d.Campos {
				<div class="campo">
					<label for={ "rel-" + c.Nome } data-ico={ iconeDoCampo(c.Tipo) }>{ c.Rotulo }</label>
					if c.Tipo == "data" {
						<input id={ "rel-" + c.Nome } type="date" name={ c.Nome } value={ c.Valor }/>
					} else {
						<select id={ "rel-" + c.Nome } name={ c.Nome }>
							<option value="">Todos</option>
							for _, o := range c.Opcoes {
								<option value={ valorOpcao(o) } selected?={ o.Selecionada }>{ o.Rotulo }</option>
							}
						</select>
					}
				</div>
			}
			</div>
			<div class="rel-acoes">
				<button type="submit" name="gerar" value="1" class="btn btn-primario" data-icone="play">Gerar relatório</button>
				<span class="rel-baixar">
					<button type="submit" name="formato" value="pdf" class="btn" data-icone="file">Baixar PDF</button>
					<button type="submit" name="formato" value="xlsx" class="btn" data-icone="sheet">Baixar planilha</button>
					<button type="submit" name="formato" value="csv" class="btn" data-icone="table">Baixar CSV</button>
				</span>
				<a class="btn rel-limpar" href={ templ.SafeURL("/relatorios/" + d.Slug) }>Limpar</a>
			</div>
		</form>
		if d.Gerado {
			<div class="cartao tabela-rolavel rel-resultado">
				<h2 class="rel-titulo" data-ico="table">Resultado <span class="selo">{ strconv.Itoa(d.Total) } linhas</span></h2>
				if d.Cortado {
					<p class="alerta">O relatório passou do limite e foi cortado: estreite os filtros para ver o restante.</p>
				}
				if d.Total > d.Mostradas {
					<p class="subtitulo">Mostrando as primeiras { strconv.Itoa(d.Mostradas) } de { strconv.Itoa(d.Total) } linhas. Baixe o PDF, a planilha ou o CSV para ver todas.</p>
				}
				<table class="tabela">
					<thead>
						<tr>
							for _, c := range d.Colunas {
								<th>{ c }</th>
							}
						</tr>
					</thead>
					<tbody>
						if len(d.Linhas) == 0 {
							<tr><td colspan={ strconv.Itoa(len(d.Colunas)) }>Nenhum registro para estes filtros.</td></tr>
						}
						for _, l := range d.Linhas {
							<tr>
								for _, v := range l {
									<td>{ v }</td>
								}
							</tr>
						}
					</tbody>
					if len(d.Totais) > 0 && len(d.Linhas) > 0 {
						<tfoot>
							<tr>
								for _, v := range d.Totais {
									<th>{ v }</th>
								}
							</tr>
						</tfoot>
					}
				</table>
			</div>
		}
	}
}
