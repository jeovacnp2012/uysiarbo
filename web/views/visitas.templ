package views

import "strconv"

// ---- Visitas ----

templ campoTexto(id, rotulo, nome, valor, extra string) {
	<div class="campo">
		<label for={ id }>{ rotulo }</label>
		<input id={ id } name={ nome } type="search" value={ valor } placeholder={ rotulo } inputmode={ extra }/>
	</div>
}

templ campoEscolha(id, rotulo, nome, todos string, opcoes []CidadeOpcao) {
	<div class="campo">
		<label for={ id }>{ rotulo }</label>
		<select id={ id } name={ nome } class="filtro-auto" data-sb-sempre>
			<option value="">{ todos }</option>
			@opcoesDe(opcoes)
		</select>
	</div>
}

templ Visitas(l Layout, d VisitasData) {
	@Base(l) {
		@PageHeader("Visitas", "As visitas registradas pelos agentes, com filtros ao vivo.") {
			if d.PodeNova && d.LocalID != 0 {
				<a class="btn btn-primario" href={ templ.SafeURL("/visitas/nova?local=" + strconv.FormatInt(d.LocalID, 10)) }>Registrar visita</a>
			}
		}
		if d.Local != "" {
			<p class="subtitulo">Mostrando as visitas do local <strong>{ d.Local }</strong>. <a href="/visitas">Ver todas</a></p>
		}
		<form
			method="get"
			action="/visitas"
			class="cartao filtros filtros-vivos"
			hx-get="/visitas"
			hx-trigger="input delay:350ms, change delay:60ms, filtrar from:body"
			hx-sync="this:replace"
			hx-target="#visitas-lista"
			hx-select="#visitas-lista"
			hx-swap="outerHTML"
			hx-push-url="true"
			hx-indicator="#visitas-lista"
		>
			if d.LocalID != 0 {
				<input type="hidden" name="local" value={ strconv.FormatInt(d.LocalID, 10) }/>
			}
			@campoTexto("f-id", "ID", "id", d.Filtro.ID, "numeric")
			<div class="campo campo-largo">
				<label for="f-endereco">Endereço</label>
				<input id="f-endereco" name="endereco" type="search" value={ d.Filtro.Endereco } placeholder="Endereço"/>
			</div>
			@campoTexto("f-numero", "Número", "numero", d.Filtro.Numero, "")
			<div class="campo">
				<label for="f-bairro">Bairro</label>
				<select
					id="f-bairro"
					name="bairro"
					hx-get="/locais/quarteiroes?filtro=1"
					hx-include="this"
					hx-target="#f-quarteirao"
					hx-swap="innerHTML"
					hx-trigger="change"
				>
					<option value="">Todos os bairros</option>
					@opcoesDe(d.Bairros)
				</select>
			</div>
			@campoEscolha("f-quarteirao", "Quarteirão", "quarteirao", "Todos os quarteirões", d.Quarteiroes)
			@campoTexto("f-lado", "Lado", "lado", d.Filtro.Lado, "")
			@campoEscolha("f-ciclo", "Ciclo", "ciclo", "Todos os ciclos", d.Ciclos)
			@campoEscolha("f-agente", "Agente", "agente", "Todos os agentes", d.Agentes)
			@campoEscolha("f-atividade", "Atividade", "atividade", "Todas as atividades", d.Atividades)
			@campoTexto("f-semana", "Semana", "semana", d.Filtro.Semana, "numeric")
			<div class="campo">
				<label for="f-de">De</label>
				<input id="f-de" name="de" type="date" value={ d.Filtro.De } class="filtro-auto"/>
			</div>
			<div class="campo">
				<label for="f-ate">Até</label>
				<input id="f-ate" name="ate" type="date" value={ d.Filtro.Ate } class="filtro-auto"/>
			</div>
			@campoEscolha("f-pendencia", "Pendência", "pendencia", "Todas", d.Pendencias)
			@campoEscolha("f-deposito", "Depósito", "deposito", "Todos", d.Deposito)
			@campoEscolha("f-amostra", "Amostra", "amostra", "Todas", d.Amostra)
			@campoEscolha("f-tratamento", "Tratamento", "tratamento", "Todos", d.Tratamento)
			@campoEscolha("f-foto", "Foto", "foto", "Todas", d.Foto)
			<div class="campo">
				<label for="f-situacao">Situação</label>
				<select id="f-situacao" name="situacao" class="filtro-auto" data-sb-sempre>
					<option value="">Todas</option>
					<option value="ativa" selected?={ d.Filtro.Situacao == "ativa" }>Ativa</option>
					<option value="desativada" selected?={ d.Filtro.Situacao == "desativada" }>Desativada</option>
				</select>
			</div>
			<div class="form-acoes">
				<a class="btn btn-escuro" href="/visitas" data-icone="undo">Limpar filtros</a>
			</div>
			<noscript><button type="submit" class="btn btn-primario">Filtrar</button></noscript>
		</form>
		<div id="visitas-lista" class="lista-viva">
			if d.Aviso != "" {
				<p class="alerta alerta-ok" role="status">{ d.Aviso }</p>
			}
			<section class="cartao">
				@Paginacao(d.Pag, "/visitas", d.Query)
			<form method="post" action="/visitas/lote">
				<input type="hidden" name="csrf" value={ l.CSRF }/>
				<input type="hidden" name="voltar" value={ "/visitas?" + d.Query.Encode() }/>
				if d.PodeLote {
					<div class="form-acoes">
						<button type="submit" name="acao" value="desativar" class="btn" onclick="return confirm('Desativar as visitas marcadas?')">Desativar marcadas</button>
						<button type="submit" name="acao" value="reativar" class="btn">Reativar marcadas</button>
					</div>
				}
			<div class="tabela-wrap">
				<table class="tabela">
					<thead>
						<tr>
							if d.PodeLote {
								<th scope="col"><span class="sr-only">Marcar</span></th>
							}
							<th scope="col">ID</th>
							<th scope="col">Endereço</th>
							<th scope="col">Data / agente</th>
							<th scope="col">Ciclo</th>
							<th scope="col">Sem.</th>
							<th scope="col">Atividade</th>
							<th scope="col">Pendência</th>
							<th scope="col">Dep.</th>
							<th scope="col">Amostra</th>
							<th scope="col">Trat.</th>
							<th scope="col"><span class="sr-only">Ações</span></th>
						</tr>
					</thead>
					<tbody>
						for _, v := range d.Linhas {
							<tr>
								if d.PodeLote {
									<td data-rotulo="Marcar"><input type="checkbox" name="ids" value={ strconv.FormatInt(v.ID, 10) } aria-label="Marcar a visita"/></td>
								}
								<td data-rotulo="ID">{ strconv.FormatInt(v.ID, 10) }</td>
								<td data-rotulo="Endereço">{ v.Endereco }</td>
								<td data-rotulo="Data / agente">{ v.Data } — { v.Agente }</td>
								<td data-rotulo="Ciclo">{ v.Ciclo }</td>
								<td data-rotulo="Sem.">{ v.Semana }</td>
								<td data-rotulo="Atividade">{ v.Atividade }</td>
								<td data-rotulo="Pendência">{ v.Pendencia }</td>
								<td data-rotulo="Dep.">{ simNao(v.Deposito) }</td>
								<td data-rotulo="Amostra">{ simNao(v.Amostra) }</td>
								<td data-rotulo="Trat.">{ simNao(v.Tratou) }</td>
								<td data-rotulo="Ações">
									<a class="btn" href={ templ.SafeURL("/visitas/" + strconv.FormatInt(v.ID, 10)) }>Abrir</a>
									if !v.Ativo {
										<span class="selo selo-aviso">Desativada</span>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
				if len(d.Linhas) == 0 {
					<div class="tabela-vazia">Nenhuma visita encontrada.</div>
				}
			</div>
			</form>
			@Paginacao(d.Pag, "/visitas", d.Query)
			</section>
		</div>
	}
}

func simNao(b bool) string {
	if b {
		return "Sim"
	}
	return "Não"
}

templ numeroVisita(id, rotulo, nome, valor string, max string, passo string) {
	<div class="campo">
		<label for={ id }>{ rotulo }</label>
		<input id={ id } name={ nome } type="number" inputmode="decimal" min="0" max={ max } step={ passo } value={ valor }/>
	</div>
}

templ VisitaForm(l Layout, d VisitaFormData) {
	@Base(l) {
		if d.Novo() {
			@PageHeader("Registrar visita", d.Local) {
				<a class="btn" href={ templ.SafeURL("/visitas?local=" + strconv.FormatInt(d.LocalID, 10)) }>Voltar</a>
			}
		} else {
			@PageHeader("Visita "+strconv.FormatInt(d.ID, 10), d.Local) {
				<a class="btn" href={ templ.SafeURL("/visitas?local=" + strconv.FormatInt(d.LocalID, 10)) }>Voltar</a>
				<a class="btn" href={ templ.SafeURL("/locais/" + strconv.FormatInt(d.LocalID, 10)) }>Ficha do local</a>
				<button type="button" class="btn" onclick="window.print()" data-icone="imprimir">Imprimir</button>
			}
			@Presenca("visita", strconv.FormatInt(d.ID, 10), modoDaTela(d.PodeEditar))
			if !d.Ativo {
				<p class="alerta alerta-aviso" role="status">Esta visita está desativada.</p>
			}
		}
		if d.Aviso != "" {
			<p class="alerta alerta-ok" role="status">{ d.Aviso }</p>
		}
		<form
			method="post"
			if d.Novo() {
				action="/visitas"
			} else {
				action={ templ.SafeURL("/visitas/" + strconv.FormatInt(d.ID, 10)) }
			}
			class="cartao form-admin"
			x-data={ "{ achou: " + strconv.FormatBool(d.Campos.Achou) + ", trat: " + strconv.FormatBool(d.Campos.Tratamento) + ", pend: '" + d.Campos.Pendencia + "' }" }
		>
			<input type="hidden" name="csrf" value={ d.CSRF }/>
			if d.Novo() {
				<input type="hidden" name="local" value={ strconv.FormatInt(d.LocalID, 10) }/>
			}
			if d.Erro != "" {
				<p class="alerta alerta-erro" role="alert">{ d.Erro }</p>
			}
			<fieldset class="sem-borda" disabled?={ !d.PodeEditar && !d.Novo() }>
				<h2>Dados da visita</h2>
				<div class="grade-form">
					<div class="campo">
						<label for="data">Data</label>
						<input id="data" name="data" type="date" value={ d.Campos.Data } required/>
					</div>
					<div class="campo">
						<label for="hora">Hora de entrada</label>
						<input id="hora" name="hora" type="time" value={ d.Campos.Hora }/>
					</div>
					<div class="campo">
						<label for="ciclo">Ciclo</label>
						<select id="ciclo" name="ciclo" required>
							for _, o := range d.Ciclos {
								<option value={ strconv.FormatInt(o.ID, 10) } selected?={ o.Selecionada }>{ o.Rotulo }</option>
							}
						</select>
					</div>
					<div class="campo">
						<label for="atividade">Atividade</label>
						<select id="atividade" name="atividade" required>
							for _, o := range d.Atividade {
								<option value={ strconv.FormatInt(o.ID, 10) } selected?={ o.Selecionada }>{ o.Rotulo }</option>
							}
						</select>
					</div>
					<div class="campo">
						<label for="agente">Agente</label>
						<select id="agente" name="agente" required>
							for _, o := range d.Agentes {
								<option value={ strconv.FormatInt(o.ID, 10) } selected?={ o.Selecionada }>{ o.Rotulo }</option>
							}
						</select>
					</div>
					<div class="campo">
						<label for="tipo">Tipo de visita</label>
						<select id="tipo" name="tipo">
							for _, o := range d.Tipos {
								<option value={ o.Valor } selected?={ o.Selecionada }>{ o.Rotulo }</option>
							}
						</select>
					</div>
					<div class="campo">
						<label for="pendencia">Pendência</label>
						<select id="pendencia" name="pendencia" x-model="pend" disabled?={ !d.PodeEditarPendencia && !d.Novo() }>
							for _, o := range d.Pendencias {
								<option value={ o.Valor } selected?={ o.Selecionada }>{ o.Rotulo }</option>
							}
						</select>
						if !d.PodeEditarPendencia && !d.Novo() {
							<input type="hidden" name="pendencia" value={ d.Campos.Pendencia }/>
						}
					</div>
					if d.Semana != "" {
						<div class="campo">
							<label>Semana epidemiológica</label>
							<p class="subtitulo">{ d.Semana }</p>
						</div>
					}
				</div>
				<p class="subtitulo" x-show="pend !== 'nenhuma'" x-cloak>Visita com pendência (imóvel fechado, recusa ou tentativa): não tem depósitos, amostra nem tratamento.</p>

				<div x-show="pend === 'nenhuma'">
					<h2>Depósitos</h2>
					<label class="marcar">
						<input type="checkbox" name="achou" value="1" x-model="achou" checked?={ d.Campos.Achou }/>
						Encontrou depósitos
					</label>
					<div class="grade-form" x-show="achou" x-cloak>
						@numeroVisita("a1", "A1", "a1", d.Campos.A1, "9999", "1")
						@numeroVisita("a2", "A2", "a2", d.Campos.A2, "9999", "1")
						@numeroVisita("b", "B", "b", d.Campos.B, "9999", "1")
						@numeroVisita("c", "C", "c", d.Campos.C, "9999", "1")
						@numeroVisita("d1", "D1", "d1", d.Campos.D1, "9999", "1")
						@numeroVisita("d2", "D2", "d2", d.Campos.D2, "9999", "1")
						@numeroVisita("e", "E", "e", d.Campos.E, "9999", "1")
						@numeroVisita("total-eliminado", "Total eliminado", "total_eliminado", d.Campos.TotalEliminado, "9999", "1")
					</div>

					<h2>Amostra</h2>
					<label class="marcar">
						<input type="checkbox" name="amostra" value="1" checked?={ d.Campos.Amostra }/>
						Coletou amostra (os tubitos e o resultado ficam no Laboratório)
					</label>

					<h2>Tratamento</h2>
					<label class="marcar">
						<input type="checkbox" name="tratamento" value="1" x-model="trat" checked?={ d.Campos.Tratamento }/>
						Fez tratamento
					</label>
					<div class="grade-form" x-show="trat" x-cloak>
						@numeroVisita("l1-gramas", "Larvicida L1 (gramas)", "l1_gramas", d.Campos.L1Gramas, "99999", "0.01")
						@numeroVisita("l1-tratados", "L1: depósitos tratados", "l1_tratados", d.Campos.L1Tratados, "9999", "1")
						@numeroVisita("l2-gramas", "Larvicida L2 (gramas)", "l2_gramas", d.Campos.L2Gramas, "99999", "0.01")
						@numeroVisita("l2-tratados", "L2: depósitos tratados", "l2_tratados", d.Campos.L2Tratados, "9999", "1")
						<div class="campo">
							<label for="adulticida-tipo">Adulticida (tipo)</label>
							<input id="adulticida-tipo" name="adulticida_tipo" type="text" maxlength="40" value={ d.Campos.AdulticidaTipo }/>
						</div>
						@numeroVisita("adulticida-cargas", "Adulticida (cargas)", "adulticida_cargas", d.Campos.AdulticidaCargas, "9999", "1")
						@numeroVisita("trat-eliminados", "Depósitos eliminados no tratamento", "trat_eliminados", d.Campos.TratEliminados, "9999", "1")
						@numeroVisita("bri", "BRI: volume aplicado", "bri_volume", d.Campos.Bri, "99999", "0.01")
					</div>
				</div>

				<h2>Posição e anotação</h2>
				<div class="grade-form">
					<div class="campo">
						<label for="lat">Latitude</label>
						<input id="lat" name="lat" type="text" inputmode="decimal" value={ d.Campos.Lat }/>
					</div>
					<div class="campo">
						<label for="lon">Longitude</label>
						<input id="lon" name="lon" type="text" inputmode="decimal" value={ d.Campos.Lon }/>
					</div>
					<div class="campo">
						<label for="precisao">Precisão do GPS (m)</label>
						<input id="precisao" name="precisao" type="text" inputmode="decimal" value={ d.Campos.Precisao }/>
					</div>
				</div>
				<div class="campo">
					<label for="anotacao">Anotação do agente</label>
					<textarea id="anotacao" name="anotacao" rows="3" maxlength="4000">{ d.Campos.Anotacao }</textarea>
				</div>
				<div class="campo">
					<label for="assinatura">Assinatura do morador (imagem em base64, enviada pelo aplicativo)</label>
					<textarea id="assinatura" name="assinatura" rows="2" spellcheck="false">{ d.Campos.Assinatura }</textarea>
				</div>
			</fieldset>
			if d.PodeEditar || d.Novo() {
				<div class="form-acoes">
					<button type="submit" class="btn btn-primario">Salvar</button>
					<a class="btn" href={ templ.SafeURL("/visitas?local=" + strconv.FormatInt(d.LocalID, 10)) }>Cancelar</a>
				</div>
			}
		</form>
		if !d.Novo() {
			if d.Campos.Assinatura != "" {
				<section class="cartao" id="assinatura-imagem">
					<h2>Assinatura</h2>
					<img src={ templ.URL(d.Campos.Assinatura) } alt="Assinatura do morador" width="320"/>
				</section>
			}
			<section class="cartao form-admin" id="fotos">
				<h2>Fotos</h2>
				if d.ErroFoto != "" {
					<p class="alerta alerta-erro" role="alert">{ d.ErroFoto }</p>
				}
				if len(d.Fotos) == 0 {
					<p class="subtitulo">Nenhuma foto.</p>
				}
				<div class="grade-secoes">
					for _, f := range d.Fotos {
						<div class="secao-ficha">
							<a href={ templ.SafeURL("/visitas/" + strconv.FormatInt(d.ID, 10) + "/fotos/" + strconv.FormatInt(f.ID, 10)) } target="_blank" rel="noopener">
								<img src={ "/visitas/" + strconv.FormatInt(d.ID, 10) + "/fotos/" + strconv.FormatInt(f.ID, 10) } alt={ "Foto " + f.Nome } loading="lazy" width="200"/>
							</a>
							<span class="subtitulo">{ f.Nome } ({ f.Tamanho })</span>
							if d.PodeEditar {
								<form method="post" action={ templ.SafeURL("/visitas/" + strconv.FormatInt(d.ID, 10) + "/fotos/" + strconv.FormatInt(f.ID, 10) + "/excluir") } class="inline" onsubmit="return confirm('Enviar a foto para a lixeira?')">
									<input type="hidden" name="csrf" value={ d.CSRF }/>
									<button type="submit" class="btn">Excluir foto</button>
								</form>
							}
						</div>
					}
				</div>
				if d.PodeEditar {
					<form method="post" action={ templ.SafeURL("/visitas/" + strconv.FormatInt(d.ID, 10) + "/fotos") } enctype="multipart/form-data" class="form-admin">
						<input type="hidden" name="csrf" value={ d.CSRF }/>
						<div class="campo">
							<label for="foto">Adicionar fotos (JPEG, PNG ou WebP, até 5 MB cada)</label>
							<input id="foto" name="foto" type="file" accept="image/jpeg,image/png,image/webp" multiple required/>
						</div>
						<div class="form-acoes">
							<button type="submit" class="btn">Enviar fotos</button>
						</div>
					</form>
				}
			</section>
			<section class="cartao form-admin" id="anotacoes">
				<h2>Anotações internas</h2>
				if len(d.Anotacoes) == 0 {
					<p class="subtitulo">Nenhuma anotação.</p>
				}
				for _, a := range d.Anotacoes {
					<p><strong>{ a.Autor }</strong> <span class="subtitulo">{ a.Quando.In(d.Fuso).Format("02/01/2006 15:04") }</span><br/>{ a.Texto }</p>
				}
				if d.PodeAnotar {
					<form method="post" action={ templ.SafeURL("/visitas/" + strconv.FormatInt(d.ID, 10) + "/anotacoes") } class="form-admin">
						<input type="hidden" name="csrf" value={ d.CSRF }/>
						<div class="campo">
							<label for="nova-anotacao">Nova anotação</label>
							<textarea id="nova-anotacao" name="texto" rows="2" maxlength="2000" required></textarea>
						</div>
						<div class="form-acoes">
							<button type="submit" class="btn">Adicionar anotação</button>
						</div>
					</form>
				}
			</section>
			if d.MostrarHistorico {
				<section class="cartao" id="historico">
					<h2>Histórico de alterações</h2>
					if len(d.Historico) == 0 {
						<div class="tabela-vazia">Nenhuma alteração registrada.</div>
					} else {
						<div class="tabela-wrap">
							<table class="tabela">
								<tbody>
									for _, u := range d.Historico {
										<tr>
											<td data-rotulo="Quando">{ u.Quando }</td>
											<td data-rotulo="Quem">{ u.Ator }</td>
											<td data-rotulo="O quê">{ u.Acao }</td>
											<td data-rotulo="Registro">{ u.Registro }</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					}
				</section>
			}
			<section class="cartao form-admin" id="amostras">
				<h2>Amostras (tubitos)</h2>
				if d.ErroAmostra != "" {
					<p class="alerta alerta-erro" role="alert">{ d.ErroAmostra }</p>
				}
				if !d.ColetouAmostra && len(d.Amostras) == 0 {
					<p class="subtitulo">Esta visita não coletou amostra.</p>
				}
				for _, a := range d.Amostras {
					<div class="cartao amostra">
						<h3>Tubito { a.Tubito } <span class="selo">{ a.StatusRotulo }</span></h3>
						<form method="post" action={ templ.SafeURL("/visitas/" + strconv.FormatInt(d.ID, 10) + "/amostras/" + strconv.FormatInt(a.ID, 10)) } class="filtros">
							<input type="hidden" name="csrf" value={ d.CSRF }/>
							<div class="campo">
								<label for={ "dep-" + strconv.FormatInt(a.ID, 10) }>Depósito</label>
								<select id={ "dep-" + strconv.FormatInt(a.ID, 10) } name="deposito" disabled?={ !d.PodeEditar }>
									<option value="">—</option>
									@opcoesDe(a.Depositos)
								</select>
							</div>
							@numeroVisita("lar-"+strconv.FormatInt(a.ID, 10), "Larvas", "larvas", strconv.Itoa(a.Larvas), "9999", "1")
							@numeroVisita("pup-"+strconv.FormatInt(a.ID, 10), "Pupas", "pupas", strconv.Itoa(a.Pupas), "9999", "1")
							<div class="campo campo-largo">
								<label for={ "obs-" + strconv.FormatInt(a.ID, 10) }>Observação</label>
								<input id={ "obs-" + strconv.FormatInt(a.ID, 10) } name="observacao" maxlength="1000" value={ a.Observacao } disabled?={ !d.PodeEditar }/>
							</div>
							if d.PodeEditar {
								<div class="form-acoes"><button type="submit" class="btn">Salvar coleta</button></div>
							}
						</form>
						<form method="post" action={ templ.SafeURL("/visitas/" + strconv.FormatInt(d.ID, 10) + "/amostras/" + strconv.FormatInt(a.ID, 10) + "/resultado") } class="filtros">
							<input type="hidden" name="csrf" value={ d.CSRF }/>
							<div class="campo">
								<label for={ "st-" + strconv.FormatInt(a.ID, 10) }>Status</label>
								<select id={ "st-" + strconv.FormatInt(a.ID, 10) } name="status" disabled?={ !d.PodeResultado }>
									@opcoesDe(a.Situacoes)
								</select>
							</div>
							@numeroVisita("aeg-"+strconv.FormatInt(a.ID, 10), "Total Aedes aegypti", "aegypti", strconv.Itoa(a.Aegypti), "99999", "1")
							@numeroVisita("alb-"+strconv.FormatInt(a.ID, 10), "Total Aedes albopictus", "albopictus", strconv.Itoa(a.Albopictus), "99999", "1")
							@numeroVisita("neg-"+strconv.FormatInt(a.ID, 10), "Total negativo", "negativo", strconv.Itoa(a.Negativo), "99999", "1")
							if d.PodeResultado {
								<div class="form-acoes"><button type="submit" class="btn btn-primario">Salvar resultado</button></div>
							}
						</form>
						if d.PodeEditar {
							<form method="post" action={ templ.SafeURL("/visitas/" + strconv.FormatInt(d.ID, 10) + "/amostras/" + strconv.FormatInt(a.ID, 10) + "/excluir") } class="inline" onsubmit="return confirm('Enviar o tubito para a lixeira?')">
								<input type="hidden" name="csrf" value={ d.CSRF }/>
								<button type="submit" class="btn">Excluir tubito</button>
							</form>
						}
					</div>
				}
				if d.PodeAmostra {
					<h3>Novo tubito</h3>
					<form method="post" action={ templ.SafeURL("/visitas/" + strconv.FormatInt(d.ID, 10) + "/amostras") } class="filtros">
						<input type="hidden" name="csrf" value={ d.CSRF }/>
						if !d.TubitoAutomatico {
							<div class="campo">
								<label for="novo-tubito">Número do tubito</label>
								<input id="novo-tubito" name="tubito" maxlength="30" required/>
							</div>
						} else {
							<p class="subtitulo">O número do tubito é gerado automaticamente.</p>
						}
						<div class="campo">
							<label for="novo-dep">Depósito</label>
							<select id="novo-dep" name="deposito">
								<option value="">—</option>
								@opcoesDe(d.DepositosNovos)
							</select>
						</div>
						@numeroVisita("novo-lar", "Larvas", "larvas", "0", "9999", "1")
						@numeroVisita("novo-pup", "Pupas", "pupas", "0", "9999", "1")
						<div class="campo campo-largo">
							<label for="novo-obs">Observação</label>
							<input id="novo-obs" name="observacao" maxlength="1000"/>
						</div>
						<div class="form-acoes"><button type="submit" class="btn btn-sucesso">Adicionar tubito</button></div>
					</form>
				}
			</section>
			if d.PodeExcluir {
				<section class="cartao form-admin" id="situacao">
					<h2>Situação da visita</h2>
					<p class="subtitulo">Desativar esconde a visita das listagens e dos números, sem apagar nada; dá para reativar.</p>
					<form method="post" action={ templ.SafeURL("/visitas/" + strconv.FormatInt(d.ID, 10) + "/ativo") } class="inline">
						<input type="hidden" name="csrf" value={ d.CSRF }/>
						if d.Ativo {
							<input type="hidden" name="ativo" value="0"/>
							<button type="submit" class="btn">Desativar visita</button>
						} else {
							<input type="hidden" name="ativo" value="1"/>
							<button type="submit" class="btn btn-sucesso">Reativar visita</button>
						}
					</form>
				</section>
			}
			if d.PodeExcluir {
				<section class="cartao form-admin" id="excluir">
					<h2>Excluir visita</h2>
					<p class="subtitulo">Nada é apagado de verdade: a visita vai para a Lixeira e dá para restaurar.</p>
					<form method="post" action={ templ.SafeURL("/visitas/" + strconv.FormatInt(d.ID, 10) + "/excluir") } class="inline" onsubmit="return confirm('Enviar a visita para a lixeira?')">
						<input type="hidden" name="csrf" value={ d.CSRF }/>
						<button type="submit" class="btn">Excluir visita</button>
					</form>
				</section>
			}
		}
	}
}
