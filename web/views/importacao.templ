package views

import (
	"net/url"
	"strconv"
)

type ImportacaoTipoOpcao struct {
	Codigo string
	Rotulo string
	Descr  string
	Marcado bool
}

type ImportacaoColunaAjuda struct {
	Nome        string
	Rotulo      string
	Obrigatoria bool
	Ajuda       string
}

type ImportacaoLinhaResumo struct {
	ID        int64
	Tipo      string
	Arquivo   string
	Status    string
	StatusRotulo string
	Quando    string
	Quem      string
	Total     int
	Resumo    string
}

type ImportacoesListaData struct {
	Linhas []ImportacaoLinhaResumo
	Aviso  string
}

type ImportacaoLinhaPrevia struct {
	N         int
	Acao      string
	Mensagem  string
	Resumo    string // as primeiras células da planilha
	Resultado string
	ResultadoMsg string
}

type ImportacaoFichaData struct {
	ID            int64
	Tipo          string
	TipoRotulo    string
	Arquivo       string
	Origem        string // de onde vieram os dados (planilha, Geo Controle, API...)
	Status        string
	StatusRotulo  string
	Mensagem      string
	Quem          string
	Criada        string
	Concluida     string
	ModoAtualizar bool
	ColunasIgnoradas string
	Total         int
	ParaCriar, ParaAtualizar, ParaIgnorar, ComErro int // previsão da análise
	Processadas   int
	Criados, Atualizados, Ignorados, Erros, Desfeitos int
	Percentual    int
	Filtro        string
	Linhas        []ImportacaoLinhaPrevia
	Pag           Pagination
	Query         url.Values
	PodeExecutar  bool
	PodeDesfazer  bool
	Aviso         string
	CSRF          string
}

func (d ImportacaoFichaData) Executando() bool { return d.Status == "executando" }

templ ImportacoesLista(l Layout, d ImportacoesListaData) {
	@Base(l) {
		@PageHeader("Importação de dados", "Traga bairros, quarteirões e locais de planilhas, com prévia antes de gravar e possibilidade de desfazer.") {
			<a class="btn btn-primario" href="/importacoes/nova">Nova importação</a>
		}
		if d.Aviso != "" {
			<p class="alerta alerta-ok" role="status">{ d.Aviso }</p>
		}
		<section class="cartao">
			<div class="tabela-wrap">
				<table class="tabela">
					<thead>
						<tr>
							<th scope="col">Importação</th>
							<th scope="col">Quando</th>
							<th scope="col">Quem</th>
							<th scope="col">Situação</th>
							<th scope="col">Resultado</th>
							<th scope="col"><span class="sr-only">Ações</span></th>
						</tr>
					</thead>
					<tbody>
						for _, i := range d.Linhas {
							<tr>
								<td data-rotulo="Importação"><strong>{ i.Tipo }</strong><div class="subtitulo">{ i.Arquivo } · { strconv.Itoa(i.Total) } linha(s)</div></td>
								<td data-rotulo="Quando">{ i.Quando }</td>
								<td data-rotulo="Quem">{ i.Quem }</td>
								<td data-rotulo="Situação"><span class={ "selo", seloDaImportacao(i.Status) }>{ i.StatusRotulo }</span></td>
								<td data-rotulo="Resultado">{ i.Resumo }</td>
								<td data-rotulo="Ações"><a class="btn" href={ templ.SafeURL("/importacoes/" + strconv.FormatInt(i.ID, 10)) }>Abrir</a></td>
							</tr>
						}
					</tbody>
				</table>
				if len(d.Linhas) == 0 {
					<div class="tabela-vazia">Nenhuma importação feita.</div>
				}
			</div>
		</section>
	}
}

func seloDaImportacao(status string) string {
	switch status {
	case "concluida":
		return "selo-ok"
	case "erro", "interrompida", "cancelada":
		return "selo-aviso"
	}
	return ""
}

type ImportacaoConectorOpcao struct {
	Codigo  string
	Rotulo  string
	Descr   string
	Fonte   string // "arquivo" ou "api"
	Marcado bool
}

type ImportacaoMapeamentoOpcao struct {
	ID     int64
	Rotulo string
}

type ImportacaoNovaData struct {
	Tipos       []ImportacaoTipoOpcao
	Conectores  []ImportacaoConectorOpcao
	Mapeamentos []ImportacaoMapeamentoOpcao
	Conector    string
	Atualizar   bool
	Revisar     bool
	URL         string
	Caminho     string
	Colunas     map[string][]ImportacaoColunaAjuda
	MaxMB       int
	MaxLinhas   int
	Erro        string
	CSRF        string
}

// Mapeamento de colunas.
type ImportacaoMapaLinha struct {
	Nome        string // coluna do sistema
	Rotulo      string
	Obrigatoria bool
	Ajuda       string
	Escolhido   string // cabeçalho da origem hoje ligado a ela ("" = não importar)
}

type ImportacaoMapearData struct {
	ID          int64
	TipoRotulo  string
	Conector    string
	Arquivo     string
	Cabecalhos  []string
	Linhas      []ImportacaoMapaLinha
	Mapeamentos []ImportacaoMapeamentoOpcao
	SalvarNome  string
	Erro        string
	CSRF        string
	Amostra     [][]string // primeiras linhas da origem, para a pessoa se orientar
}

type ImportacaoMapeamentoLinha struct {
	ID       int64
	Nome     string
	Conector string
	Tipo     string
	Colunas  int
	Quando   string
}

type ImportacaoMapeamentosData struct {
	Linhas []ImportacaoMapeamentoLinha
	CSRF   string
}

templ ImportacaoNova(l Layout, d ImportacaoNovaData) {
	@Base(l) {
		@PageHeader("Nova importação", "Os dados são analisados primeiro: nada é gravado até você conferir a prévia e confirmar.") {
			<a class="btn" href="/importacoes/mapeamentos">Mapeamentos salvos</a>
			<a class="btn" href="/importacoes">Voltar</a>
		}
		<form method="post" action="/importacoes" enctype="multipart/form-data" class="cartao form-admin" x-data={ "{ conector: " + strconv.Quote(d.Conector) + " }" }>
			<input type="hidden" name="csrf" value={ d.CSRF }/>
			if d.Erro != "" {
				<p class="alerta alerta-erro" role="alert">{ d.Erro }</p>
			}
			<h2>1. De onde vêm os dados</h2>
			for _, c := range d.Conectores {
				<label class="marcar">
					<input type="radio" name="conector" value={ c.Codigo } x-model="conector" checked?={ c.Marcado }/>
					<span><strong>{ c.Rotulo }</strong> <span class="subtitulo">{ c.Descr }</span></span>
				</label>
			}
			<h2>2. O que importar</h2>
			for _, t := range d.Tipos {
				<label class="marcar">
					<input type="radio" name="tipo" value={ t.Codigo } checked?={ t.Marcado } required/>
					<span>
						<strong>{ t.Rotulo }</strong> <span class="subtitulo">{ t.Descr }</span>
						<span class="subtitulo">
							Modelo:
							<a href={ templ.SafeURL("/importacoes/modelo/" + t.Codigo + ".xlsx") }>Excel</a> ·
							<a href={ templ.SafeURL("/importacoes/modelo/" + t.Codigo + ".csv") }>CSV</a>
						</span>
					</span>
				</label>
			}
			<h2>3. Os dados</h2>
			<div x-show="['planilha','geocontrole'].includes(conector)">
				<div class="campo">
					<label for="arquivo">Planilha (.xlsx ou .csv, até { strconv.Itoa(d.MaxMB) } MB e { strconv.Itoa(d.MaxLinhas) } linhas)</label>
					<input id="arquivo" name="arquivo" type="file" accept=".xlsx,.csv,.txt"/>
				</div>
				<p class="subtitulo">A primeira linha deve ter os nomes das colunas. Se os nomes não forem os do modelo, a próxima tela deixa você ligar cada coluna.</p>
			</div>
			<div x-show="['geocontrole_api','api_rest'].includes(conector)" x-cloak>
				<div class="campo">
					<label for="url">Endereço da API (HTTPS)</label>
					<input id="url" name="url" type="url" value={ d.URL } placeholder="https://api.exemplo.com/locais" autocomplete="off"/>
				</div>
				<div class="grade-form">
					<div class="campo">
						<label for="token">Token de acesso (Bearer)</label>
						<input id="token" name="token" type="password" autocomplete="off"/>
					</div>
					<div class="campo">
						<label for="usuario">Ou usuário (HTTP Basic)</label>
						<input id="usuario" name="usuario" type="text" autocomplete="off"/>
					</div>
					<div class="campo">
						<label for="senha">Senha</label>
						<input id="senha" name="senha" type="password" autocomplete="off"/>
					</div>
					<div class="campo">
						<label for="caminho">Onde está a lista no JSON (opcional)</label>
						<input id="caminho" name="caminho" type="text" value={ d.Caminho } placeholder="data"/>
					</div>
				</div>
				<p class="subtitulo">As credenciais valem só para esta importação: o sistema não as guarda. Só endereços HTTPS da internet pública são acessados.</p>
			</div>
			if len(d.Mapeamentos) > 0 {
				<div class="campo">
					<label for="mapeamento_id">Usar um mapeamento de colunas salvo (opcional)</label>
					<select id="mapeamento_id" name="mapeamento_id">
						<option value="">Reconhecer as colunas automaticamente</option>
						for _, m := range d.Mapeamentos {
							<option value={ strconv.FormatInt(m.ID, 10) }>{ m.Rotulo }</option>
						}
					</select>
				</div>
			}
			<label class="marcar">
				<input type="checkbox" name="revisar" value="1" checked?={ d.Revisar }/>
				Revisar o mapeamento das colunas antes de analisar (obrigatório quando faltar alguma coluna)
			</label>
			<h2>4. Se o registro já existir</h2>
			<label class="marcar">
				<input type="checkbox" name="atualizar" value="1" checked?={ d.Atualizar }/>
				Atualizar os registros que já existem (só com o que vier preenchido). Sem marcar, eles são ignorados.
			</label>
			<div class="form-acoes">
				<button type="submit" class="btn btn-primario">Analisar</button>
				<a class="btn" href="/importacoes">Cancelar</a>
			</div>
		</form>
		<section class="cartao">
			<h2>Colunas de cada tipo</h2>
			for _, t := range d.Tipos {
				<details>
					<summary>{ t.Rotulo }</summary>
					<div class="tabela-wrap">
						<table class="tabela">
							<thead>
								<tr>
									<th scope="col">Coluna</th>
									<th scope="col">Obrigatória</th>
									<th scope="col">Como preencher</th>
								</tr>
							</thead>
							<tbody>
								for _, c := range d.Colunas[t.Codigo] {
									<tr>
										<td data-rotulo="Coluna"><code>{ c.Nome }</code> <span class="subtitulo">{ c.Rotulo }</span></td>
										<td data-rotulo="Obrigatória">
											if c.Obrigatoria {
												sim
											} else {
												não
											}
										</td>
										<td data-rotulo="Como preencher">{ c.Ajuda }</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				</details>
			}
		</section>
	}
}

templ ImportacaoMapear(l Layout, d ImportacaoMapearData) {
	@Base(l) {
		@PageHeader("Ligar as colunas", "Importação de "+d.TipoRotulo+": "+d.Arquivo) {
			<form method="post" action={ templ.SafeURL("/importacoes/" + strconv.FormatInt(d.ID, 10) + "/cancelar") } class="inline">
				<input type="hidden" name="csrf" value={ d.CSRF }/>
				<button type="submit" class="btn">Descartar</button>
			</form>
		}
		<section class="cartao">
			<h2>O que veio da origem</h2>
			<div class="tabela-wrap">
				<table class="tabela">
					<thead>
						<tr>
							for _, c := range d.Cabecalhos {
								<th scope="col">{ c }</th>
							}
						</tr>
					</thead>
					<tbody>
						for _, linha := range d.Amostra {
							<tr>
								for _, c := range linha {
									<td>{ c }</td>
								}
							</tr>
						}
					</tbody>
				</table>
			</div>
		</section>
		<form method="post" action={ templ.SafeURL("/importacoes/" + strconv.FormatInt(d.ID, 10) + "/mapear") } class="cartao form-admin">
			<input type="hidden" name="csrf" value={ d.CSRF }/>
			if d.Erro != "" {
				<p class="alerta alerta-erro" role="alert">{ d.Erro }</p>
			}
			<h2>Qual coluna da origem vai para cada campo do sistema</h2>
			if len(d.Mapeamentos) > 0 {
				<p class="subtitulo">
					Mapeamentos salvos:
					for _, m := range d.Mapeamentos {
						<a href={ templ.SafeURL("/importacoes/" + strconv.FormatInt(d.ID, 10) + "/mapear?mapeamento=" + strconv.FormatInt(m.ID, 10)) }>{ m.Rotulo }</a>
						{ " " }
					}
				</p>
			}
			<div class="tabela-wrap">
				<table class="tabela">
					<thead>
						<tr>
							<th scope="col">Campo do sistema</th>
							<th scope="col">Coluna da origem</th>
						</tr>
					</thead>
					<tbody>
						for _, c := range d.Linhas {
							<tr>
								<td data-rotulo="Campo">
									<strong>{ c.Rotulo }</strong>
									if c.Obrigatoria {
										<span class="selo selo-aviso">obrigatório</span>
									}
									if c.Ajuda != "" {
										<div class="subtitulo">{ c.Ajuda }</div>
									}
								</td>
								<td data-rotulo="Coluna da origem">
									<select name={ "col_" + c.Nome } aria-label={ "Coluna para " + c.Rotulo }>
										<option value="">(não importar)</option>
										for _, h := range d.Cabecalhos {
											<option value={ h } selected?={ h == c.Escolhido }>{ h }</option>
										}
									</select>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			<div class="campo">
				<label for="salvar_nome">Salvar este mapeamento com o nome (opcional, para usar nas próximas importações)</label>
				<input id="salvar_nome" name="salvar_nome" type="text" value={ d.SalvarNome } maxlength="100"/>
			</div>
			<div class="form-acoes">
				<button type="submit" class="btn btn-primario">Analisar com este mapeamento</button>
			</div>
		</form>
	}
}

templ ImportacaoMapeamentos(l Layout, d ImportacaoMapeamentosData) {
	@Base(l) {
		@PageHeader("Mapeamentos de colunas", "Ligações de colunas salvas, por origem e tipo de dado, para repetir importações sem refazer a escolha.") {
			<a class="btn" href="/importacoes/nova">Nova importação</a>
		}
		<section class="cartao">
			<div class="tabela-wrap">
				<table class="tabela">
					<thead>
						<tr>
							<th scope="col">Nome</th>
							<th scope="col">Origem · dado</th>
							<th scope="col">Colunas</th>
							<th scope="col">Criado em</th>
							<th scope="col"><span class="sr-only">Ações</span></th>
						</tr>
					</thead>
					<tbody>
						for _, m := range d.Linhas {
							<tr>
								<td data-rotulo="Nome"><strong>{ m.Nome }</strong></td>
								<td data-rotulo="Origem · dado">{ m.Conector } · { m.Tipo }</td>
								<td data-rotulo="Colunas">{ strconv.Itoa(m.Colunas) }</td>
								<td data-rotulo="Criado em">{ m.Quando }</td>
								<td data-rotulo="Ações">
									<form method="post" action={ templ.SafeURL("/importacoes/mapeamentos/" + strconv.FormatInt(m.ID, 10) + "/excluir") } class="inline" onsubmit="return confirm('Enviar este mapeamento para a lixeira?')">
										<input type="hidden" name="csrf" value={ d.CSRF }/>
										<button type="submit" class="btn btn-icone" aria-label={ "Excluir o mapeamento " + m.Nome }>Excluir</button>
									</form>
								</td>
							</tr>
						}
					</tbody>
				</table>
				if len(d.Linhas) == 0 {
					<div class="tabela-vazia">Nenhum mapeamento salvo.</div>
				}
			</div>
		</section>
	}
}

// ImportacaoProgresso é o trecho que se atualiza sozinho enquanto a importação roda.
templ ImportacaoProgresso(d ImportacaoFichaData) {
	<div
		id="progresso"
		if d.Executando() {
			hx-get={ "/importacoes/" + strconv.FormatInt(d.ID, 10) + "/progresso" }
			hx-trigger="every 2s"
			hx-swap="outerHTML"
		}
	>
		<div class="barra" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow={ strconv.Itoa(d.Percentual) }>
			<div class="barra-cheia" style={ "width:" + strconv.Itoa(d.Percentual) + "%" }></div>
		</div>
		<p>{ strconv.Itoa(d.Processadas) } de { strconv.Itoa(d.Total) } linha(s) ({ strconv.Itoa(d.Percentual) }%): { strconv.Itoa(d.Criados) } criada(s), { strconv.Itoa(d.Atualizados) } atualizada(s), { strconv.Itoa(d.Ignorados) } ignorada(s), { strconv.Itoa(d.Erros) } com erro.</p>
	</div>
}

templ ImportacaoFicha(l Layout, d ImportacaoFichaData) {
	@Base(l) {
		@PageHeader("Importação de "+d.TipoRotulo, d.Arquivo) {
			<a class="btn" href="/importacoes">Voltar</a>
			<a class="btn" href={ templ.SafeURL("/importacoes/" + strconv.FormatInt(d.ID, 10) + "/relatorio.csv") }>Relatório (CSV)</a>
			if d.ComErro > 0 || d.Erros > 0 {
				<a class="btn" href={ templ.SafeURL("/importacoes/" + strconv.FormatInt(d.ID, 10) + "/erros.csv") }>Só as linhas com erro</a>
			}
		}
		if d.Aviso != "" {
			<p class="alerta alerta-ok" role="status">{ d.Aviso }</p>
		}
		<section class="cartao">
			<p>
				<span class={ "selo", seloDaImportacao(d.Status) }>{ d.StatusRotulo }</span>
				Origem: { d.Origem }. Enviada por { d.Quem } em { d.Criada }.
				if d.Concluida != "" {
					Terminou em { d.Concluida }.
				}
			</p>
			if d.Mensagem != "" {
				<p class="subtitulo">{ d.Mensagem }</p>
			}
			if d.ColunasIgnoradas != "" {
				<p class="alerta alerta-aviso" role="status">Colunas da planilha que o sistema não conhece e foram ignoradas: { d.ColunasIgnoradas }.</p>
			}
			if d.Status == "mapeando" {
				<h2>Falta ligar as colunas</h2>
				<p class="subtitulo">Os dados foram recebidos, mas ainda não analisados: escolha qual coluna da origem vai para cada campo do sistema.</p>
				<a class="btn btn-primario" href={ templ.SafeURL("/importacoes/" + strconv.FormatInt(d.ID, 10) + "/mapear") }>Ligar as colunas</a>
			} else if d.Status == "analisada" {
				<h2>Prévia: nada foi gravado ainda</h2>
				<div class="grade-resumo">
					<div><strong>{ strconv.Itoa(d.ParaCriar) }</strong><span class="subtitulo">serão criadas</span></div>
					<div><strong>{ strconv.Itoa(d.ParaAtualizar) }</strong><span class="subtitulo">serão atualizadas</span></div>
					<div><strong>{ strconv.Itoa(d.ParaIgnorar) }</strong><span class="subtitulo">serão ignoradas</span></div>
					<div><strong>{ strconv.Itoa(d.ComErro) }</strong><span class="subtitulo">com erro (não entram)</span></div>
				</div>
				if d.ModoAtualizar {
					<p class="alerta alerta-aviso" role="status">Modo "atualizar existentes": as atualizações podem ser desfeitas depois, restaurando o estado anterior.</p>
				}
				<div class="form-acoes">
					if d.PodeExecutar {
						<form method="post" action={ templ.SafeURL("/importacoes/" + strconv.FormatInt(d.ID, 10) + "/executar") } class="inline">
							<input type="hidden" name="csrf" value={ d.CSRF }/>
							<button type="submit" class="btn btn-primario">Confirmar e importar</button>
						</form>
					} else {
						<span class="subtitulo">Nada a criar ou atualizar: corrija a planilha e envie de novo.</span>
					}
					<form method="post" action={ templ.SafeURL("/importacoes/" + strconv.FormatInt(d.ID, 10) + "/cancelar") } class="inline">
						<input type="hidden" name="csrf" value={ d.CSRF }/>
						<button type="submit" class="btn">Descartar</button>
					</form>
				</div>
			} else if d.Status == "executando" || d.Status == "interrompida" {
				<h2>Andamento</h2>
				@ImportacaoProgresso(d)
				<div class="form-acoes">
					if d.Status == "executando" {
						<form method="post" action={ templ.SafeURL("/importacoes/" + strconv.FormatInt(d.ID, 10) + "/interromper") } class="inline">
							<input type="hidden" name="csrf" value={ d.CSRF }/>
							<button type="submit" class="btn">Interromper</button>
						</form>
					} else {
						<form method="post" action={ templ.SafeURL("/importacoes/" + strconv.FormatInt(d.ID, 10) + "/retomar") } class="inline">
							<input type="hidden" name="csrf" value={ d.CSRF }/>
							<button type="submit" class="btn btn-primario">Retomar</button>
						</form>
					}
				</div>
			} else if d.Status == "concluida" || d.Status == "desfeita" {
				<h2>Resultado</h2>
				@ImportacaoProgresso(d)
				if d.Desfeitos > 0 {
					<p class="subtitulo">{ strconv.Itoa(d.Desfeitos) } linha(s) desfeita(s).</p>
				}
				if d.PodeDesfazer {
					<form method="post" action={ templ.SafeURL("/importacoes/" + strconv.FormatInt(d.ID, 10) + "/desfazer") } class="inline">
						<input type="hidden" name="csrf" value={ d.CSRF }/>
						<button type="submit" class="btn">Desfazer esta importação</button>
					</form>
					<p class="subtitulo">Apaga o que foi criado e devolve o que foi atualizado ao estado anterior. O que já estiver em uso por outros dados (por exemplo, um bairro que ganhou locais depois) é mantido e avisado.</p>
				}
			}
		</section>
		<form method="get" action={ templ.SafeURL("/importacoes/" + strconv.FormatInt(d.ID, 10)) } class="cartao filtros">
			<div class="campo">
				<label for="f-acao">Mostrar linhas</label>
				<select id="f-acao" name="acao">
					<option value="">Todas ({ strconv.Itoa(d.Total) })</option>
					<option value="criar" selected?={ d.Filtro == "criar" }>A criar</option>
					<option value="atualizar" selected?={ d.Filtro == "atualizar" }>A atualizar</option>
					<option value="ignorar" selected?={ d.Filtro == "ignorar" }>A ignorar</option>
					<option value="erro" selected?={ d.Filtro == "erro" }>Com erro</option>
				</select>
			</div>
			<div class="form-acoes">
				<button type="submit" class="btn btn-primario">Filtrar</button>
			</div>
		</form>
		<section class="cartao">
			<div class="tabela-wrap">
				<table class="tabela">
					<thead>
						<tr>
							<th scope="col">Linha</th>
							<th scope="col">Análise</th>
							<th scope="col">Dados</th>
							<th scope="col">Resultado</th>
						</tr>
					</thead>
					<tbody>
						for _, x := range d.Linhas {
							<tr>
								<td data-rotulo="Linha">{ strconv.Itoa(x.N) }</td>
								<td data-rotulo="Análise">
									<span class={ "selo", seloDaAcao(x.Acao) }>{ rotuloDaAcao(x.Acao) }</span>
									if x.Mensagem != "" {
										<div class="subtitulo">{ x.Mensagem }</div>
									}
								</td>
								<td data-rotulo="Dados">{ x.Resumo }</td>
								<td data-rotulo="Resultado">
									{ x.Resultado }
									if x.ResultadoMsg != "" {
										<div class="subtitulo">{ x.ResultadoMsg }</div>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
				if len(d.Linhas) == 0 {
					<div class="tabela-vazia">Nenhuma linha neste filtro.</div>
				}
			</div>
			<div class="paginacao">
				<span>{ d.Pag.Summary() } · página { strconv.Itoa(d.Pag.Page) } de { strconv.Itoa(d.Pag.Pages()) }</span>
				<div class="paginacao-botoes">
					<a class="btn" href={ templ.SafeURL(pageURL("/importacoes/" + strconv.FormatInt(d.ID, 10), d.Query, d.Pag.Page-1)) } aria-disabled?={ !d.Pag.HasPrev() }>← Anterior</a>
					<a class="btn" href={ templ.SafeURL(pageURL("/importacoes/" + strconv.FormatInt(d.ID, 10), d.Query, d.Pag.Page+1)) } aria-disabled?={ !d.Pag.HasNext() }>Próxima →</a>
				</div>
			</div>
		</section>
	}
}

func rotuloDaAcao(a string) string {
	switch a {
	case "criar":
		return "criar"
	case "atualizar":
		return "atualizar"
	case "ignorar":
		return "ignorar"
	}
	return "erro"
}

func seloDaAcao(a string) string {
	switch a {
	case "criar", "atualizar":
		return "selo-ok"
	case "erro":
		return "selo-aviso"
	}
	return ""
}
