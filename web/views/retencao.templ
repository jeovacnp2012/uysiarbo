package views

import "strconv"

type RetencaoLinha struct {
	Chave, Rotulo   string
	Meses, Vencidos int
}

type RetencaoData struct {
	Linhas            []RetencaoLinha
	Aviso, Erro, CSRF string
}

templ Retencao(l Layout, d RetencaoData) {
	@Base(l) {
		@PageHeader("Retenção de dados (LGPD)", "Depois do prazo, os dados pessoais de casos encerrados ou cancelados são apagados sozinhos (o paciente vira ANONIMIZADO). O resto do caso fica.") {
		}
		if d.Aviso != "" {
			<p class="alerta alerta-ok" role="status">{ d.Aviso }</p>
		}
		if d.Erro != "" {
			<p class="alerta alerta-erro" role="alert">{ d.Erro }</p>
		}
		<form method="post" action="/lgpd/retencao" class="cartao" hx-boost="false">
			<input type="hidden" name="csrf" value={ d.CSRF }/>
			for _, x := range d.Linhas {
				<div class="campo">
					<label for={ "ret-" + x.Chave }>{ x.Rotulo }: guardar os dados pessoais por (meses)</label>
					<input id={ "ret-" + x.Chave } name={ x.Chave } type="number" min="0" max="600" value={ strconv.Itoa(x.Meses) }/>
					if x.Meses == 0 {
						<small>0 = não apagar.</small>
					} else {
						<small>{ strconv.Itoa(x.Vencidos) } registro(s) já passaram do prazo.</small>
					}
				</div>
			}
			<div class="form-acoes">
				<button type="submit" class="btn btn-primario" data-icone="save">Salvar prazos</button>
			</div>
		</form>
		<form method="post" action="/lgpd/retencao/executar" class="cartao" hx-boost="false">
			<input type="hidden" name="csrf" value={ d.CSRF }/>
			<p>O sistema aplica os prazos sozinho a cada 6 horas. Use o botão para aplicar agora. Não tem volta.</p>
			<div class="form-acoes">
				<button type="submit" class="btn btn-perigo" data-icone="trash">Aplicar agora</button>
			</div>
		</form>
	}
}
