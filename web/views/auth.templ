package views

type LoginData struct {
	Cliente string // nome do cliente; vazio no console da plataforma
	Email   string
	Erro    string
	Proximo string
	CSRF    string
	SiteKey string // chave pública do reCAPTCHA; vazio = sem captcha
}

type TrocarSenhaData struct {
	Cliente     string
	Nome        string
	Obrigatoria bool // true depois de um reset: não dá para continuar sem trocar
	Erro        string
	CSRF        string
}

// authShell é a moldura das telas de acesso (sem menu): entrar e trocar senha.
templ authShell(titulo, cliente string, recaptcha bool) {
	<!DOCTYPE html>
	<html lang="pt-BR">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ titulo } · UYSI ARBO</title>
			<script>
				(function () {
					try {
						var t = localStorage.getItem('uysi-tema');
						if (t === 'escuro' || (!t && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
							document.documentElement.dataset.tema = 'escuro';
						}
					} catch (e) {}
				})();
			</script>
			<link rel="icon" href={ asset("/static/brand/uysi-symbol.png") }/>
			<link rel="stylesheet" href={ asset("/static/css/app.css") }/>
			<script defer src={ asset("/static/js/app.js") }></script>
			<script defer src={ asset("/static/vendor/alpine.min.js") }></script>
			if recaptcha {
				<script src="https://www.google.com/recaptcha/api.js" async defer></script>
			}
		</head>
		<body class="entrar" x-data>
			<main class="entrar-cartao">
				<div class="entrar-marca">
					<img src={ asset("/static/brand/uysi-symbol.png") } alt=""/>
					<div>
						<strong>UYSI ARBO</strong>
						if cliente != "" {
							<div class="entrar-cliente">{ cliente }</div>
						} else {
							<div class="entrar-cliente">Console da plataforma</div>
						}
					</div>
				</div>
				{ children... }
			</main>
		</body>
	</html>
}

// Login é a tela de entrar.
templ Login(d LoginData) {
	@authShell("Entrar", d.Cliente, d.SiteKey != "") {
		<h1 class="titulo">Entrar</h1>
		<form method="post" action="/entrar" class="entrar-form">
			<input type="hidden" name="csrf" value={ d.CSRF }/>
			<input type="hidden" name="proximo" value={ d.Proximo }/>
			if d.Erro != "" {
				<p class="alerta alerta-erro" role="alert">{ d.Erro }</p>
			}
			<div class="campo">
				<label for="email">E-mail</label>
				<input id="email" name="email" type="email" value={ d.Email } autocomplete="username" required autofocus/>
			</div>
			@PasswordField("senha", "senha", "Senha", "current-password")
			if d.SiteKey != "" {
				<div class="g-recaptcha" data-sitekey={ d.SiteKey }></div>
			}
			<button type="submit" class="btn btn-primario entrar-botao">Entrar</button>
		</form>
		<p class="subtitulo">Esqueceu a senha? Peça a um administrador para gerar uma nova.</p>
	}
}

// TrocarSenha é a tela de trocar a própria senha, obrigatória depois de um reset.
templ TrocarSenha(d TrocarSenhaData) {
	@authShell("Trocar senha", d.Cliente, false) {
		<h1 class="titulo">Escolha a sua senha</h1>
		if d.Obrigatoria {
			<p class="subtitulo">Olá, { d.Nome }. A senha que você recebeu é temporária: escolha uma senha só sua para continuar.</p>
		} else {
			<p class="subtitulo">{ d.Nome }, informe a senha atual e a nova senha.</p>
		}
		<form method="post" action="/trocar-senha" class="entrar-form">
			<input type="hidden" name="csrf" value={ d.CSRF }/>
			if d.Erro != "" {
				<p class="alerta alerta-erro" role="alert">{ d.Erro }</p>
			}
			@PasswordField("atual", "atual", "Senha atual (ou temporária)", "current-password")
			@PasswordField("nova", "nova", "Nova senha", "new-password")
			@PasswordField("confirmar", "confirmar", "Repita a nova senha", "new-password")
			<p class="subtitulo">Mínimo de 10 caracteres, com letras e números.</p>
			<button type="submit" class="btn btn-primario entrar-botao">Salvar senha</button>
		</form>
		if !d.Obrigatoria {
			<p class="subtitulo"><a href="/">Voltar</a></p>
		}
	}
}
