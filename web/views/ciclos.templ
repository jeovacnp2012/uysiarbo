package views

import "strconv"

// ---- Ciclos ----

templ Ciclos(l Layout, d CiclosData) {
	@Base(l) {
		@PageHeader("Ciclos", "Os períodos de trabalho (em geral 6 por ano), com as atividades de cada um e a situação: operando ou fechado.") {
			if d.PodeEditar {
				<a class="btn btn-primario" href="/ciclos/novo">Novo ciclo</a>
			}
		}
		<section class="cartao">
			<div class="tabela-wrap">
				<table class="tabela">
					<thead>
						<tr>
							<th scope="col">Ciclo</th>
							<th scope="col">Período</th>
							<th scope="col">Semanas epidemiológicas</th>
							<th scope="col">Atividades</th>
							<th scope="col">Situação</th>
							<th scope="col">Painel público</th>
							<th scope="col"><span class="sr-only">Ações</span></th>
						</tr>
					</thead>
					<tbody>
						for _, c := range d.Linhas {
							<tr>
								<td data-rotulo="Ciclo"><strong>{ c.Nome }</strong></td>
								<td data-rotulo="Período">{ c.Inicio } a { c.Final }</td>
								<td data-rotulo="Semanas epidemiológicas">{ c.Semanas }</td>
								<td data-rotulo="Atividades">{ c.Atividades }</td>
								<td data-rotulo="Situação">
									if c.Fechado {
										<span class="selo selo-aviso">Fechado</span>
									} else {
										<span class="selo selo-ok">Operando</span>
									}
								</td>
								<td data-rotulo="Painel público">
									if c.Publico {
										Sim
									} else {
										Não
									}
								</td>
								<td data-rotulo="Ações"><a class="btn" href={ templ.SafeURL("/ciclos/" + strconv.FormatInt(c.ID, 10)) }>Abrir</a></td>
							</tr>
						}
					</tbody>
				</table>
				if len(d.Linhas) == 0 {
					<div class="tabela-vazia">Nenhum ciclo cadastrado. Cadastre o primeiro para registrar visitas e atividades.</div>
				}
			</div>
		</section>
		<form method="post" action="/ciclos/semana" class="cartao form-admin">
			<input type="hidden" name="csrf" value={ d.CSRF }/>
			<h2>Semana epidemiológica</h2>
			<p class="subtitulo">Como as semanas são numeradas neste ambiente. Hoje: { d.RotuloSemana }.</p>
			<fieldset class="sem-borda" disabled?={ !d.PodeEditar }>
				<label class="marcar">
					<input type="radio" name="tipo" value="sinan" checked?={ d.TipoSemana == "sinan" }/>
					SINAN / Ministério da Saúde: semanas de domingo a sábado; a semana 1 é a que tem ao menos 4 dias em janeiro
				</label>
				<label class="marcar">
					<input type="radio" name="tipo" value="iso" checked?={ d.TipoSemana == "iso" }/>
					ISO 8601: semanas de segunda a domingo; a semana 1 é a que tem a primeira quinta-feira do ano
				</label>
			</fieldset>
			if d.PodeEditar {
				<div class="form-acoes">
					<button type="submit" class="btn btn-primario">Salvar</button>
				</div>
			}
		</form>
	}
}

templ CicloForm(l Layout, d CicloFormData) {
	@Base(l) {
		if d.Novo() {
			@PageHeader("Novo ciclo", "") {
				<a class="btn" href="/ciclos">Voltar</a>
			}
		} else {
			@PageHeader("Ciclo", d.Nome) {
				<a class="btn" href="/ciclos">Voltar</a>
			}
			@Presenca("ciclo", strconv.FormatInt(d.ID, 10), modoDaTela(d.PodeEditar))
		}
		<form
			method="post"
			if d.Novo() {
				action="/ciclos"
			} else {
				action={ templ.SafeURL("/ciclos/" + strconv.FormatInt(d.ID, 10)) }
			}
			class="cartao form-admin"
		>
			<input type="hidden" name="csrf" value={ d.CSRF }/>
			if d.Erro != "" {
				<p class="alerta alerta-erro" role="alert">{ d.Erro }</p>
			}
			if d.Aviso != "" {
				<p class="alerta alerta-aviso" role="status">{ d.Aviso }</p>
			}
			if d.Semanas != "" {
				<p class="subtitulo">Semanas epidemiológicas: { d.Semanas }</p>
			}
			<fieldset class="sem-borda" disabled?={ !d.PodeEditar }>
				<div class="campo">
					<label for="nome">Nome do ciclo</label>
					<input id="nome" name="nome" type="text" value={ d.Nome } maxlength="60" placeholder="05 Ciclo - 2026" required/>
				</div>
				<div class="grade-form">
					<div class="campo">
						<label for="data_inicio">Data de início</label>
						<input id="data_inicio" name="data_inicio" type="date" value={ d.Inicio } required/>
					</div>
					<div class="campo">
						<label for="data_final">Data final</label>
						<input id="data_final" name="data_final" type="date" value={ d.Final } required/>
					</div>
				</div>
				<label class="marcar">
					<input type="checkbox" name="fechado" value="1" checked?={ d.Fechado }/>
					Ciclo fechado (bloqueia a edição dos registros do ciclo, salvo para quem tem permissão própria)
				</label>
				<label class="marcar">
					<input type="checkbox" name="fora_periodo" value="1" checked?={ d.PermiteForaPeriodo }/>
					Permitir registros com data fora do período do ciclo
				</label>
				<div class="campo">
					<span class="rotulo">Atividades do ciclo</span>
					<div class="grade-marcar">
						for _, a := range d.Atividades {
							<label class="marcar">
								<input type="checkbox" name="atividade" value={ strconv.Itoa(int(a.ID)) } checked?={ a.Marcada }/>
								<strong>{ a.Sigla }</strong> { a.Nome }
							</label>
						}
					</div>
				</div>
				<label class="marcar">
					<input type="checkbox" name="painel_publico" value="1" checked?={ d.PainelPublico }/>
					Mostrar este ciclo no painel público
				</label>
				<div class="campo">
					<label for="painel_texto">Nome mostrado no painel público (opcional)</label>
					<input id="painel_texto" name="painel_texto" type="text" value={ d.PainelTexto } maxlength="100"/>
				</div>
				<div class="campo">
					<span class="rotulo">Atividades mostradas no painel público</span>
					<div class="grade-marcar">
						for _, a := range d.Atividades {
							<label class="marcar">
								<input type="checkbox" name="painel_atividade" value={ strconv.Itoa(int(a.ID)) } checked?={ a.NoPainel }/>
								<strong>{ a.Sigla }</strong>
							</label>
						}
					</div>
				</div>
				if len(d.Sincronizar) > 0 {
					<div class="campo">
						<span class="rotulo">Ciclos sincronizados (o que se registra neste ciclo também vale para estes)</span>
						<div class="grade-marcar">
							for _, c := range d.Sincronizar {
								<label class="marcar">
									<input type="checkbox" name="sincronizar" value={ strconv.FormatInt(c.ID, 10) } checked?={ c.Marcado }/>
									{ c.Nome }
								</label>
							}
						</div>
					</div>
				}
			</fieldset>
			if d.PodeEditar {
				<div class="form-acoes">
					<button type="submit" class="btn btn-primario">Salvar</button>
					<a class="btn" href="/ciclos">Cancelar</a>
				</div>
			}
		</form>
		if !d.Novo() && d.PodeEditar {
			<section class="cartao form-admin" id="excluir">
				<h2>Excluir ciclo</h2>
				<p class="subtitulo">Nada é apagado de verdade: o ciclo vai para a Lixeira e dá para restaurar.</p>
				<form method="post" action={ templ.SafeURL("/ciclos/" + strconv.FormatInt(d.ID, 10) + "/excluir") } class="inline" onsubmit="return confirm('Enviar para a lixeira?')">
					<input type="hidden" name="csrf" value={ d.CSRF }/>
					<button type="submit" class="btn">Excluir ciclo</button>
				</form>
			</section>
		}
	}
}
