package views

type EsqueciSenhaData struct {
	Cliente string
	Email   string
	Erro    string
	Enviado bool // pedido aceito: a tela só avisa, sem dizer se o e-mail existe
	CSRF    string
	SiteKey string
}

type RedefinirSenhaData struct {
	Cliente  string
	Codigo   string
	Erro     string
	Invalido bool // link inexistente, vencido ou já usado
	Pronto   bool // senha trocada
	CSRF     string
}

// EsqueciSenha é o pedido de recuperação de senha por e-mail.
templ EsqueciSenha(d EsqueciSenhaData) {
	@authShell("Esqueci a senha", d.Cliente, d.SiteKey != "") {
		<h1 class="titulo">Esqueci a senha</h1>
		if d.Enviado {
			<p class="alerta alerta-sucesso" role="status">Se o e-mail estiver cadastrado, enviamos um link para criar uma nova senha. Ele vale por 1 hora e só pode ser usado uma vez.</p>
			<p class="subtitulo"><a href="/entrar">Voltar para entrar</a></p>
		} else {
			<p class="subtitulo">Informe o e-mail da sua conta. Enviaremos um link para você escolher uma nova senha.</p>
			<form method="post" action="/esqueci-senha" class="entrar-form">
				<input type="hidden" name="csrf" value={ d.CSRF }/>
				if d.Erro != "" {
					<p class="alerta alerta-erro" role="alert">{ d.Erro }</p>
				}
				<div class="campo">
					<label for="email">E-mail</label>
					<input id="email" name="email" type="email" value={ d.Email } autocomplete="username" required autofocus/>
				</div>
				if d.SiteKey != "" {
					<div class="g-recaptcha" data-sitekey={ d.SiteKey }></div>
				}
				<button type="submit" class="btn btn-primario entrar-botao">Enviar link</button>
			</form>
			<p class="subtitulo"><a href="/entrar">Voltar para entrar</a></p>
		}
	}
}

// RedefinirSenha é a tela aberta pelo link do e-mail.
templ RedefinirSenha(d RedefinirSenhaData) {
	@authShell("Nova senha", d.Cliente, false) {
		<h1 class="titulo">Nova senha</h1>
		if d.Pronto {
			<p class="alerta alerta-sucesso" role="status">Senha alterada. Entre com a nova senha.</p>
			<p class="subtitulo"><a href="/entrar">Entrar</a></p>
		} else if d.Invalido {
			<p class="alerta alerta-erro" role="alert">Este link não vale mais (venceu ou já foi usado). Peça um novo.</p>
			<p class="subtitulo"><a href="/esqueci-senha">Pedir novo link</a></p>
		} else {
			<form method="post" action="/redefinir-senha" class="entrar-form">
				<input type="hidden" name="csrf" value={ d.CSRF }/>
				<input type="hidden" name="codigo" value={ d.Codigo }/>
				if d.Erro != "" {
					<p class="alerta alerta-erro" role="alert">{ d.Erro }</p>
				}
				@PasswordField("nova", "nova", "Nova senha", "new-password")
				@PasswordField("confirmar", "confirmar", "Repita a nova senha", "new-password")
				<p class="subtitulo">Mínimo de 10 caracteres, com letras e números.</p>
				<button type="submit" class="btn btn-primario entrar-botao">Salvar senha</button>
			</form>
		}
	}
}
