package views

import "strconv"

// ---- Painel inicial ----

// Home é o painel inicial: atalhos para as telas, números e, no cliente, todos os módulos do sistema.
templ Home(l Layout, d PainelData) {
	@Base(l) {
		if d.Console {
			@PageHeader("Console da plataforma", "Administração geral: clientes, usuários da plataforma e histórico. Cada prefeitura tem o seu próprio ambiente.") {
				if d.Master {
					<a class="btn btn-primario" href="/clientes">Clientes</a>
				}
			}
		} else {
			@PageHeader("Olá, "+d.Cliente, "Ambiente de "+d.Cliente+" · sistema "+d.Sistema+".") {
				<a class="btn btn-primario" href="/componentes">Ver componentes</a>
			}
		}
		if d.Console {
			<section class="grade-cartoes">
				<div class="cartao numero">
					<span class="numero-valor">{ strconv.Itoa(d.ClientesAtivos) }</span>
					<span class="subtitulo">clientes ativos</span>
				</div>
				<div class="cartao numero">
					<span class="numero-valor">{ strconv.Itoa(d.ClientesSuspensos) }</span>
					<span class="subtitulo">clientes suspensos ou em preparo</span>
				</div>
			</section>
		}
		<section class="cartao">
			<h2>Atalhos</h2>
			<div class="grade-atalhos">
				for _, a := range d.Atalhos {
					<a class="atalho" href={ templ.SafeURL(a.Href) }>
						<strong>{ a.Titulo }</strong>
						<span class="subtitulo">{ a.Descricao }</span>
					</a>
				}
			</div>
		</section>
		if !d.Console {
			<section class="cartao">
				<h2>Módulos do sistema</h2>
				<p class="subtitulo">
					Todos os módulos que o seu papel permite. Eles são entregues por etapas: os marcados "em construção" ainda não têm tela.
				</p>
				<div class="grade-modulos">
					for _, m := range d.Modulos {
						if m.Href != "" {
							<a class="modulo modulo-pronto" href={ templ.SafeURL(m.Href) }>
								<span>{ m.Nome }</span>
								<span class="selo selo-ok">disponível</span>
							</a>
						} else {
							<div class="modulo">
								<span>{ m.Nome }</span>
								<span class="selo selo-aviso">em construção</span>
							</div>
						}
					}
				</div>
			</section>
		}
		if len(d.Ultimos) > 0 {
			<section class="cartao">
				<h2>Últimas atividades</h2>
				<div class="tabela-wrap">
					<table class="tabela">
						<tbody>
							for _, u := range d.Ultimos {
								<tr>
									<td data-rotulo="Quando">{ u.Quando }</td>
									<td data-rotulo="Quem">{ u.Ator }</td>
									<td data-rotulo="O quê">{ u.Acao }</td>
									<td data-rotulo="Registro">{ u.Registro }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</section>
		}
	}
}

// ---- Auditoria ----

templ Auditoria(l Layout, d AuditoriaData) {
	@Base(l) {
		if d.Console {
			@PageHeader("Auditoria da plataforma", "Tudo o que é feito no console, na linha de comando e com os clientes. O histórico só cresce: ninguém altera nem apaga.") {
			}
		} else {
			@PageHeader("Auditoria", "Tudo o que é feito neste ambiente: quem, quando, de onde e o que mudou. O histórico só cresce: ninguém altera nem apaga.") {
			}
		}
		<form method="get" action="/auditoria" class="cartao filtros">
			<div class="campo">
				<label for="f-de">De</label>
				<input id="f-de" name="de" type="date" value={ d.Filtro.De }/>
			</div>
			<div class="campo">
				<label for="f-ate">Até</label>
				<input id="f-ate" name="ate" type="date" value={ d.Filtro.Ate }/>
			</div>
			<div class="campo">
				<label for="f-ator">Quem (nome ou e-mail)</label>
				<input id="f-ator" name="ator" type="search" value={ d.Filtro.Ator }/>
			</div>
			<div class="campo">
				<label for="f-acao">Ação</label>
				<select id="f-acao" name="acao">
					<option value="">Todas</option>
					for _, a := range d.Acoes {
						<option value={ a.Codigo } selected?={ a.Marcada }>{ a.Rotulo }</option>
					}
				</select>
			</div>
			<div class="campo">
				<label for="f-busca">Registro afetado</label>
				<input id="f-busca" name="busca" type="search" value={ d.Filtro.Busca } placeholder="Nome ou código"/>
			</div>
			<div class="form-acoes">
				<button type="submit" class="btn btn-primario">Filtrar</button>
				<a class="btn" href="/auditoria">Limpar</a>
			</div>
		</form>
		<section class="cartao">
			<div class="tabela-wrap">
				<table class="tabela">
					<thead>
						<tr>
							<th scope="col">Quando</th>
							<th scope="col">Quem</th>
							<th scope="col">O quê</th>
							<th scope="col">Registro</th>
							<th scope="col">De onde</th>
						</tr>
					</thead>
					<tbody>
						for _, u := range d.Linhas {
							<tr>
								<td data-rotulo="Quando">{ u.Quando }</td>
								<td data-rotulo="Quem">
									{ u.Ator }
									if u.AtorTipo == "plataforma" {
										<span class="selo">plataforma</span>
									} else if u.AtorTipo == "sistema" {
										<span class="selo">sistema</span>
									}
								</td>
								<td data-rotulo="O quê">
									<details class="detalhe-aud">
										<summary>{ u.Acao }</summary>
										<div class="detalhe-corpo">
											<p class="subtitulo">Código: <code>{ u.Codigo }</code> · navegador: { u.Navegador }</p>
											if len(u.Mudancas) > 0 {
												<table class="tabela tabela-mudancas">
													<thead>
														<tr><th>Campo</th><th>Antes</th><th>Depois</th></tr>
													</thead>
													<tbody>
														for _, m := range u.Mudancas {
															<tr>
																<td data-rotulo="Campo"><strong>{ m.Campo }</strong></td>
																<td data-rotulo="Antes">{ m.Antes }</td>
																<td data-rotulo="Depois">{ m.Depois }</td>
															</tr>
														}
													</tbody>
												</table>
											}
											if len(u.Observacoes) > 0 {
												<ul class="obs-lista">
													for _, o := range u.Observacoes {
														<li><strong>{ o.Campo }:</strong> { o.Valor }</li>
													}
												</ul>
											}
										</div>
									</details>
								</td>
								<td data-rotulo="Registro">{ u.Registro }</td>
								<td data-rotulo="De onde">{ u.IP }</td>
							</tr>
						}
					</tbody>
				</table>
				if len(d.Linhas) == 0 {
					<div class="tabela-vazia">Nenhum registro encontrado para estes filtros.</div>
				}
			</div>
			<div class="paginacao">
				<span>{ d.Pag.Summary() } · página { strconv.Itoa(d.Pag.Page) } de { strconv.Itoa(d.Pag.Pages()) }</span>
				<div class="paginacao-botoes">
					<a class="btn" href={ templ.SafeURL(pageURL("/auditoria", d.Query, d.Pag.Page-1)) } aria-disabled?={ !d.Pag.HasPrev() }>← Anterior</a>
					<a class="btn" href={ templ.SafeURL(pageURL("/auditoria", d.Query, d.Pag.Page+1)) } aria-disabled?={ !d.Pag.HasNext() }>Próxima →</a>
				</div>
			</div>
		</section>
	}
}

// ---- Clientes ----

templ Clientes(l Layout, d ClientesData) {
	@Base(l) {
		@PageHeader("Clientes", "As prefeituras atendidas. Cada uma tem o seu endereço, o seu banco de dados (schema) e os seus usuários.") {
			<a class="btn btn-primario" href="/clientes/novo">Novo cliente</a>
		}
		<section class="cartao">
			<div class="tabela-wrap">
				<table class="tabela">
					<thead>
						<tr>
							<th scope="col">Cliente</th>
							<th scope="col">Endereço</th>
							<th scope="col">Situação</th>
							<th scope="col">Criado em</th>
							<th scope="col"><span class="sr-only">Ações</span></th>
						</tr>
					</thead>
					<tbody>
						for _, c := range d.Linhas {
							<tr>
								<td data-rotulo="Cliente">
									<strong>{ c.Nome }</strong>
									<div class="subtitulo">schema <code>{ c.Schema }</code></div>
								</td>
								<td data-rotulo="Endereço"><a href={ templ.SafeURL(c.URL) } target="_blank" rel="noopener">{ c.Endereco }</a></td>
								<td data-rotulo="Situação">
									if c.Status == "ativo" {
										<span class="selo selo-ok">Ativo</span>
									} else if c.Status == "suspenso" {
										<span class="selo selo-aviso">Suspenso</span>
									} else {
										<span class="selo selo-perigo">{ c.Status }</span>
									}
								</td>
								<td data-rotulo="Criado em">{ c.Criado }</td>
								<td data-rotulo="Ações" class="acoes">
									<a class="btn" href={ templ.SafeURL(c.URL) } target="_blank" rel="noopener">Abrir ambiente</a>
									if c.Status == "ativo" {
										<form method="post" action={ templ.SafeURL("/clientes/" + c.Slug + "/status") } class="inline">
											<input type="hidden" name="csrf" value={ d.CSRF }/>
											<input type="hidden" name="status" value="suspenso"/>
											<button type="submit" class="btn btn-perigo">Suspender</button>
										</form>
									} else if c.Status == "suspenso" {
										<form method="post" action={ templ.SafeURL("/clientes/" + c.Slug + "/status") } class="inline">
											<input type="hidden" name="csrf" value={ d.CSRF }/>
											<input type="hidden" name="status" value="ativo"/>
											<button type="submit" class="btn">Reativar</button>
										</form>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
				if len(d.Linhas) == 0 {
					<div class="tabela-vazia">Nenhum cliente cadastrado.</div>
				}
			</div>
		</section>
	}
}

templ ClienteForm(l Layout, d ClienteFormData) {
	@Base(l) {
		@PageHeader("Novo cliente", "Você escolhe o subdomínio. O sistema cria o ambiente, o banco do cliente e o papel Administrador.") {
			<a class="btn" href="/clientes">Voltar</a>
		}
		<form method="post" action="/clientes" class="cartao form-admin" x-data={ "{ sub: " + jsString(d.Subdominio) + " }" }>
			<input type="hidden" name="csrf" value={ d.CSRF }/>
			if d.Erro != "" {
				<p class="alerta alerta-erro" role="alert">{ d.Erro }</p>
			}
			<div class="campo">
				<label for="nome">Nome do cliente</label>
				<input id="nome" name="nome" type="text" value={ d.Nome } maxlength="120" placeholder="Prefeitura Municipal de ..." required/>
			</div>
			<div class="campo">
				<label for="slug">Identificador (3 a 30 letras minúsculas e números)</label>
				<input id="slug" name="slug" type="text" value={ d.Slug } maxlength="30" pattern="[a-z][a-z0-9]{2,29}" placeholder="novamutum" required/>
			</div>
			<div class="campo">
				<label for="subdominio">Subdomínio de acesso</label>
				<input id="subdominio" name="subdominio" type="text" x-model="sub" value={ d.Subdominio } maxlength="63" placeholder="uysiarbonm" required/>
				<span class="subtitulo">O cliente acessará: <strong x-text="(sub || '...') + '.' + $el.dataset.base" data-base={ d.BaseDominio }>...</strong></span>
			</div>
			<div class="campo">
				<label for="dominio">Domínio próprio (opcional)</label>
				<input id="dominio" name="dominio" type="text" value={ d.Dominio } maxlength="120" placeholder="arbo.prefeitura.gov.br"/>
			</div>
			<div class="campo">
				<label for="plano">Plano</label>
				<input id="plano" name="plano" type="text" value={ d.Plano } maxlength="40" placeholder="padrao"/>
			</div>
			<div class="form-acoes">
				<button type="submit" class="btn btn-primario">Criar cliente</button>
				<a class="btn" href="/clientes">Cancelar</a>
			</div>
		</form>
	}
}

// ---- Usuários da plataforma ----

templ Masters(l Layout, d MastersData) {
	@Base(l) {
		@PageHeader("Usuários da plataforma", "Quem administra o sistema em todos os clientes. O master faz tudo, em qualquer ambiente.") {
			<a class="btn btn-primario" href="/plataforma/usuarios/novo">Novo master</a>
		}
		<section class="cartao">
			<div class="tabela-wrap">
				<table class="tabela">
					<thead>
						<tr>
							<th scope="col">Nome</th>
							<th scope="col">Tipo</th>
							<th scope="col">Último acesso</th>
							<th scope="col">Situação</th>
							<th scope="col"><span class="sr-only">Ações</span></th>
						</tr>
					</thead>
					<tbody>
						for _, u := range d.Linhas {
							<tr>
								<td data-rotulo="Nome">
									<strong>{ u.Nome }</strong>
									if u.Eu {
										<span class="selo">você</span>
									}
									<div class="subtitulo">{ u.Email }</div>
								</td>
								<td data-rotulo="Tipo">
									if u.Master {
										<span class="selo selo-ok">master</span>
									} else {
										<span class="selo">comum</span>
									}
								</td>
								<td data-rotulo="Último acesso">{ u.UltimoAcesso }</td>
								<td data-rotulo="Situação">
									if !u.Ativo {
										<span class="selo selo-aviso">Inativo</span>
									} else if u.DeveTrocar {
										<span class="selo selo-aviso">Troca de senha pendente</span>
									} else {
										<span class="selo selo-ok">Ativo</span>
									}
								</td>
								<td data-rotulo="Ações" class="acoes">
									if !u.Eu {
										<form method="post" action={ templ.SafeURL("/plataforma/usuarios/" + u.ID + "/resetar-senha") } class="inline">
											<input type="hidden" name="csrf" value={ d.CSRF }/>
											<button type="submit" class="btn btn-perigo">Resetar senha</button>
										</form>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</section>
	}
}

templ MasterForm(l Layout, d MasterFormData) {
	@Base(l) {
		@PageHeader("Novo master", "Cria um usuário com acesso total, com senha temporária forte mostrada uma única vez.") {
			<a class="btn" href="/plataforma/usuarios">Voltar</a>
		}
		<form method="post" action="/plataforma/usuarios" class="cartao form-admin">
			<input type="hidden" name="csrf" value={ d.CSRF }/>
			if d.Erro != "" {
				<p class="alerta alerta-erro" role="alert">{ d.Erro }</p>
			}
			<div class="campo">
				<label for="nome">Nome completo</label>
				<input id="nome" name="nome" type="text" value={ d.Nome } maxlength="120" required/>
			</div>
			<div class="campo">
				<label for="email">E-mail de acesso</label>
				<input id="email" name="email" type="email" value={ d.Email } maxlength="160" required/>
			</div>
			<div class="form-acoes">
				<button type="submit" class="btn btn-primario">Criar master</button>
				<a class="btn" href="/plataforma/usuarios">Cancelar</a>
			</div>
		</form>
	}
}
