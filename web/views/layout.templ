package views

import "strconv"

// Base é o layout das páginas internas: menu lateral, barra superior, tema e área de toasts.
templ Base(l Layout) {
	<!DOCTYPE html>
	<html lang="pt-BR">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ l.Title } · UYSI ARBO</title>
			<script>
				(function () {
					try {
						var t = localStorage.getItem('uysi-tema');
						if (t === 'escuro' || (!t && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
							document.documentElement.dataset.tema = 'escuro';
						}
						if (localStorage.getItem('uysi-menu') === 'recolhido') {
							document.documentElement.dataset.menu = 'recolhido';
						}
					} catch (e) {}
				})();
			</script>
			<link rel="icon" href={ asset("/static/brand/uysi-symbol.png") }/>
			<link rel="stylesheet" href={ asset("/static/css/app.css") }/>
			<script defer src={ asset("/static/js/app.js") }></script>
			<script defer src={ asset("/static/js/selectbusca.js") }></script>
			<script defer src={ asset("/static/js/icones.js") }></script>
			<script defer src={ asset("/static/js/gaveta.js") }></script>
			<script defer src={ asset("/static/js/entrevista.js") }></script>
			<script defer src={ asset("/static/js/colunas.js") }></script>
			<script defer src={ asset("/static/vendor/alpine.min.js") }></script>
			<script defer src={ asset("/static/vendor/htmx.min.js") }></script>
		</head>
		<body x-data="{ menu: false }" x-on:keydown.escape.window="menu = false" hx-headers={ templ.JSONString(map[string]string{"X-CSRF-Token": l.CSRF}) }>
			<div class="app">
				<div class="menu-fundo" x-show="menu" x-cloak x-on:click="menu = false"></div>
				<aside class="menu" x-bind:class="{ aberto: menu }" aria-label="Menu principal">
					<a class="menu-marca" href="/">
						<img src={ asset("/static/brand/uysi-symbol.png") } alt=""/>
						<span>UYSI ARBO</span>
					</a>
					if l.Cliente != "" {
						<div class="menu-cliente">{ l.Cliente }</div>
					} else if l.Console {
						<div class="menu-cliente">Console da plataforma</div>
					}
					<nav class="menu-lista" id="menu-lista">
						for _, g := range l.Nav {
							if g.EmBreve {
								<span class="menu-item menu-item-embreve" title="Em construção" aria-disabled="true">
									@icone(g.Icone)
									<span class="menu-texto">{ g.Label }</span>
								</span>
							} else if g.Href != "" {
								<a class="menu-item" href={ templ.SafeURL(g.Href) } aria-current?={ g.Href == l.Active }>
									@icone(g.Icone)
									<span class="menu-texto">{ g.Label }</span>
									if g.Contagem > 0 {
										<span class="selo-contagem" title="Em análise">{ strconv.Itoa(g.Contagem) }</span>
									}
									if g.Href == "/novidades" && l.NovidadeNova {
										<span class="selo selo-aviso">nova</span>
									}
								</a>
							} else {
								<details class="menu-grupo" open?={ g.Contem(l.Active) }>
									<summary class="menu-item menu-grupo-titulo">
										@icone(g.Icone)
										<span class="menu-texto">{ g.Label }</span>
										@icone("chevron")
									</summary>
									<div class="menu-sub">
										for _, item := range g.Itens {
											if item.EmBreve {
												<span class="menu-subitem menu-subitem-embreve" title="Em construção" aria-disabled="true">{ item.Label }</span>
											} else {
												<a class="menu-subitem" href={ templ.SafeURL(item.Href) } aria-current?={ item.Href == l.Active }>{ item.Label }</a>
											}
										}
									</div>
								</details>
							}
						}
					</nav>
					<div class="menu-rodape">Versão { versaoTexto(l) }</div>
				</aside>
				<div class="conteudo">
					<header class="barra">
						<button type="button" class="btn btn-icone btn-menu" aria-label="Mostrar ou esconder o menu" title="Mostrar ou esconder o menu" x-on:click="if (window.matchMedia('(min-width: 64rem)').matches) { $store.menu.alternar() } else { menu = !menu }">☰</button>
						<div class="barra-titulo">{ l.Title }</div>
						if l.Usuario != "" {
							<span class="barra-usuario">{ l.Usuario }</span>
						}
						if l.NovidadeNova {
							<a class="btn btn-icone" href="/novidades">Novidades <span class="selo selo-aviso">nova</span></a>
						}
						<button
							type="button"
							class="btn btn-icone"
							x-on:click="$store.tema.alternar()"
							x-bind:aria-pressed="$store.tema.escuro"
							aria-label="Alternar tema claro e escuro"
						>
							<span x-text="$store.tema.escuro ? '☀ Claro' : '☾ Escuro'">☾ Escuro</span>
						</button>
						if l.Usuario != "" {
							<form method="post" action="/sair">
								<input type="hidden" name="csrf" value={ l.CSRF }/>
								<button type="submit" class="btn btn-icone">Sair</button>
							</form>
						}
					</header>
					<main class="pagina">
						if len(l.Abas) > 0 {
							<div id="aba-area" hx-boost="true" hx-target="#aba-area" hx-select="#aba-area" hx-select-oob="#menu-lista" hx-swap="outerHTML show:window:top">
								@AbasParametros(l.Abas)
								if l.Aviso != "" {
									<p class="alerta alerta-ok" role="status">{ l.Aviso }</p>
								}
								{ children... }
							</div>
						} else {
							if l.Aviso != "" {
								<p class="alerta alerta-ok" role="status">{ l.Aviso }</p>
							}
							{ children... }
						}
					</main>
				</div>
			</div>
			@Toasts()
			<noscript><p style="padding:1rem">Esta aplicação precisa de JavaScript ativado.</p></noscript>
		</body>
	</html>
}

// icone desenha um ícone de linha (24x24) do menu pelo nome. Nome desconhecido não desenha nada.
templ icone(nome string) {
	<svg class={ "ico", templ.KV("ico-chevron", nome == "chevron") } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		switch nome {
			case "inicio":
				<path d="M3 10.5 12 3l9 7.5"></path>
				<path d="M5 9.5V21h5v-6h4v6h5V9.5"></path>
			case "territorio":
				<path d="M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11z"></path>
				<circle cx="12" cy="10" r="2.5"></circle>
			case "administracao":
				<path d="M12 3 4 6v6c0 4.5 3.2 8 8 9 4.8-1 8-4.5 8-9V6l-8-3z"></path>
				<path d="m9 12 2 2 4-4"></path>
			case "plataforma":
				<rect x="4" y="3" width="16" height="18" rx="1"></rect>
				<path d="M9 7h2M13 7h2M9 11h2M13 11h2M9 15h2M13 15h2"></path>
			case "guia":
				<path d="M2 5h6a4 4 0 0 1 4 4v11a3 3 0 0 0-3-3H2z"></path>
				<path d="M22 5h-6a4 4 0 0 0-4 4v11a3 3 0 0 1 3-3h7z"></path>
			case "novidades":
				<path d="m3 11 18-5v12L3 14v-3z"></path>
				<path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"></path>
			case "visitas":
				<path d="M9 11l3 3 8-8"></path>
				<path d="M20 12v7a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h9"></path>
			case "mapa":
				<path d="M9 4 3 6.5v13L9 17l6 3 6-2.5v-13L15 7 9 4z"></path>
				<path d="M9 4v13M15 7v13"></path>
			case "dashboard":
				<circle cx="12" cy="12" r="9"></circle>
				<path d="m12 12 4-4"></path>
				<path d="M7 15.5h.01M8.5 10.5h.01M12 8h.01"></path>
			case "bi":
				<path d="M4 4v16h16"></path>
				<path d="M8 16V10M12 16V7M16 16v-4"></path>
			case "locais":
				<path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"></path>
				<circle cx="12" cy="10" r="3"></circle>
			case "laboratorio":
				<path d="M10 2v7.527a2 2 0 0 1-.211.896L4.72 20.55a1 1 0 0 0 .9 1.45h12.76a1 1 0 0 0 .9-1.45l-5.069-10.127A2 2 0 0 1 14 9.527V2"></path>
				<path d="M8.5 2h7"></path>
				<path d="M7 16h10"></path>
			case "investigacao":
				<path d="M6 18h8"></path>
				<path d="M3 22h18"></path>
				<path d="M14 22a7 7 0 1 0 0-14h-1"></path>
				<path d="M9 14h2"></path>
				<path d="M9 12a2 2 0 0 1-2-2V6h6v4a2 2 0 0 1-2 2Z"></path>
				<path d="M12 6V3a1 1 0 0 0-1-1H9a1 1 0 0 0-1 1v3"></path>
			case "denuncia":
				<path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"></path>
				<path d="M12 9v4"></path>
				<path d="M12 17h.01"></path>
			case "notificacao":
				<path d="M10.268 21a2 2 0 0 0 3.464 0"></path>
				<path d="M3.262 15.326A1 1 0 0 0 4 17h16a1 1 0 0 0 .74-1.673C19.41 13.956 18 12.499 18 8A6 6 0 0 0 6 8c0 4.499-1.411 5.956-2.738 7.326"></path>
			case "auto":
				<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7z"></path>
				<path d="M14 2v4a2 2 0 0 0 2 2h4"></path>
				<path d="M12 12v4"></path>
				<path d="M12 19h.01"></path>
			case "mobilidade":
				<path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
				<path d="M3 3v5h5"></path>
				<path d="M12 7v5l4 2"></path>
			case "bairros":
				<path d="M3 21h18"></path>
				<path d="M5 21V7l8-4v18"></path>
				<path d="M19 21V11l-6-4"></path>
			case "ovitrampa":
				<path d="M12 22c4.4 0 7-3 7-7 0-5-3.5-12-7-12S5 10 5 15c0 4 2.6 7 7 7z"></path>
			case "edl":
				<path d="M4.9 16.1C1 12.2 1 5.8 4.9 1.9"></path>
				<path d="M7.8 4.7a6.14 6.14 0 0 0-.8 7.5"></path>
				<circle cx="12" cy="9" r="2"></circle>
				<path d="M16.2 4.8c2 2 2.26 5.11.8 7.47"></path>
				<path d="M19.1 1.9a9.96 9.96 0 0 1 0 14.1"></path>
				<path d="M9.5 18h5"></path>
				<path d="m8 22 4-11 4 11"></path>
			case "drone":
				<path d="M10 10 7 7"></path>
				<path d="m14 10 3-3"></path>
				<path d="m14 14 3 3"></path>
				<path d="m10 14-3 3"></path>
				<circle cx="12" cy="12" r="2"></circle>
				<circle cx="5" cy="5" r="2.5"></circle>
				<circle cx="19" cy="5" r="2.5"></circle>
				<circle cx="5" cy="19" r="2.5"></circle>
				<circle cx="19" cy="19" r="2.5"></circle>
			case "comunicacao":
				<rect width="20" height="16" x="2" y="4" rx="2"></rect>
				<path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
			case "banner":
				<rect width="18" height="18" x="3" y="3" rx="2"></rect>
				<circle cx="9" cy="9" r="2"></circle>
				<path d="m21 15-3.09-3.09a2 2 0 0 0-2.82 0L6 21"></path>
			case "zoonose":
				<circle cx="11" cy="4" r="2"></circle>
				<circle cx="18" cy="8" r="2"></circle>
				<circle cx="20" cy="16" r="2"></circle>
				<path d="M9 10a5 5 0 0 1 5 5v3.5a3.5 3.5 0 0 1-6.84 1.045Q6.52 17.48 4.46 16.84A3.5 3.5 0 0 1 5.5 10Z"></path>
			case "liraa":
				<circle cx="12" cy="12" r="10"></circle>
				<circle cx="12" cy="12" r="6"></circle>
				<circle cx="12" cy="12" r="2"></circle>
			case "relatorios":
				<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7z"></path>
				<path d="M14 2v4a2 2 0 0 0 2 2h4"></path>
				<path d="M10 9H8"></path>
				<path d="M16 13H8"></path>
				<path d="M16 17H8"></path>
			case "estoque":
				<path d="m7.5 4.27 9 5.15"></path>
				<path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"></path>
				<path d="m3.3 7 8.7 5 8.7-5"></path>
				<path d="M12 22V12"></path>
			case "parametros":
				<path d="M10 5H3"></path>
				<path d="M12 19H3"></path>
				<path d="M14 3v4"></path>
				<path d="M16 17v4"></path>
				<path d="M21 12h-9"></path>
				<path d="M21 19h-5"></path>
				<path d="M21 5h-7"></path>
				<path d="M8 10v4"></path>
				<path d="M8 12H3"></path>
			case "auditoria":
				<circle cx="11" cy="11" r="8"></circle>
				<path d="m21 21-4.3-4.3"></path>
			case "configuracao":
				<path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"></path>
				<circle cx="12" cy="12" r="3"></circle>
			case "bi-epi":
				<path d="M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2"></path>
			case "chevron":
				<path d="m9 6 6 6-6 6"></path>
		}
	</svg>
}
