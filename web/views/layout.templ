package views

import "strconv"

// Base é o layout das páginas internas: menu lateral, barra superior, tema e área de toasts.
templ Base(l Layout) {
	<!DOCTYPE html>
	<html lang="pt-BR">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ l.Title } · UYSI ARBO</title>
			<script>
				(function () {
					try {
						var t = localStorage.getItem('uysi-tema');
						if (t === 'escuro' || (!t && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
							document.documentElement.dataset.tema = 'escuro';
						}
						if (localStorage.getItem('uysi-menu') === 'recolhido') {
							document.documentElement.dataset.menu = 'recolhido';
						}
					} catch (e) {}
				})();
			</script>
			<link rel="icon" href={ asset("/static/brand/uysi-symbol.png") }/>
			<link rel="stylesheet" href={ asset("/static/css/app.css") }/>
			<script defer src={ asset("/static/js/app.js") }></script>
			<script defer src={ asset("/static/js/selectbusca.js") }></script>
			<script defer src={ asset("/static/js/icones.js") }></script>
			<script defer src={ asset("/static/vendor/alpine.min.js") }></script>
			<script defer src={ asset("/static/vendor/htmx.min.js") }></script>
		</head>
		<body x-data="{ menu: false }" x-on:keydown.escape.window="menu = false" hx-headers={ templ.JSONString(map[string]string{"X-CSRF-Token": l.CSRF}) }>
			<div class="app">
				<div class="menu-fundo" x-show="menu" x-cloak x-on:click="menu = false"></div>
				<aside class="menu" x-bind:class="{ aberto: menu }" aria-label="Menu principal">
					<a class="menu-marca" href="/">
						<img src={ asset("/static/brand/uysi-symbol.png") } alt=""/>
						<span>UYSI ARBO</span>
					</a>
					if l.Cliente != "" {
						<div class="menu-cliente">{ l.Cliente }</div>
					} else if l.Console {
						<div class="menu-cliente">Console da plataforma</div>
					}
					<nav class="menu-lista">
						for _, g := range l.Nav {
							if g.EmBreve {
								<span class="menu-item menu-item-embreve" title="Em construção" aria-disabled="true">
									@icone(g.Icone)
									<span class="menu-texto">{ g.Label }</span>
								</span>
							} else if g.Href != "" {
								<a class="menu-item" href={ templ.SafeURL(g.Href) } aria-current?={ g.Href == l.Active }>
									@icone(g.Icone)
									<span class="menu-texto">{ g.Label }</span>
									if g.Contagem > 0 {
										<span class="selo-contagem" title="Em análise">{ strconv.Itoa(g.Contagem) }</span>
									}
									if g.Href == "/novidades" && l.NovidadeNova {
										<span class="selo selo-aviso">nova</span>
									}
								</a>
							} else {
								<details class="menu-grupo" open?={ g.Contem(l.Active) }>
									<summary class="menu-item menu-grupo-titulo">
										@icone(g.Icone)
										<span class="menu-texto">{ g.Label }</span>
										@icone("chevron")
									</summary>
									<div class="menu-sub">
										for _, item := range g.Itens {
											if item.EmBreve {
												<span class="menu-subitem menu-subitem-embreve" title="Em construção" aria-disabled="true">{ item.Label }</span>
											} else {
												<a class="menu-subitem" href={ templ.SafeURL(item.Href) } aria-current?={ item.Href == l.Active }>{ item.Label }</a>
											}
										}
									</div>
								</details>
							}
						}
					</nav>
					<div class="menu-rodape">Versão { versaoTexto(l) }</div>
				</aside>
				<div class="conteudo">
					<header class="barra">
						<button type="button" class="btn btn-icone btn-menu" aria-label="Mostrar ou esconder o menu" title="Mostrar ou esconder o menu" x-on:click="if (window.matchMedia('(min-width: 64rem)').matches) { $store.menu.alternar() } else { menu = !menu }">☰</button>
						<div class="barra-titulo">{ l.Title }</div>
						if l.Usuario != "" {
							<span class="barra-usuario">{ l.Usuario }</span>
						}
						if l.NovidadeNova {
							<a class="btn btn-icone" href="/novidades">Novidades <span class="selo selo-aviso">nova</span></a>
						}
						<button
							type="button"
							class="btn btn-icone"
							x-on:click="$store.tema.alternar()"
							x-bind:aria-pressed="$store.tema.escuro"
							aria-label="Alternar tema claro e escuro"
						>
							<span x-text="$store.tema.escuro ? '☀ Claro' : '☾ Escuro'">☾ Escuro</span>
						</button>
						if l.Usuario != "" {
							<form method="post" action="/sair">
								<input type="hidden" name="csrf" value={ l.CSRF }/>
								<button type="submit" class="btn btn-icone">Sair</button>
							</form>
						}
					</header>
					<main class="pagina">
						if l.Aviso != "" {
							<p class="alerta alerta-ok" role="status">{ l.Aviso }</p>
						}
						{ children... }
					</main>
				</div>
			</div>
			@Toasts()
			<noscript><p style="padding:1rem">Esta aplicação precisa de JavaScript ativado.</p></noscript>
		</body>
	</html>
}

// icone desenha um ícone de linha (24x24) do menu pelo nome. Nome desconhecido não desenha nada.
templ icone(nome string) {
	<svg class={ "ico", templ.KV("ico-chevron", nome == "chevron") } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		switch nome {
			case "inicio":
				<path d="M3 10.5 12 3l9 7.5"></path>
				<path d="M5 9.5V21h5v-6h4v6h5V9.5"></path>
			case "territorio":
				<path d="M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11z"></path>
				<circle cx="12" cy="10" r="2.5"></circle>
			case "administracao":
				<path d="M12 3 4 6v6c0 4.5 3.2 8 8 9 4.8-1 8-4.5 8-9V6l-8-3z"></path>
				<path d="m9 12 2 2 4-4"></path>
			case "plataforma":
				<rect x="4" y="3" width="16" height="18" rx="1"></rect>
				<path d="M9 7h2M13 7h2M9 11h2M13 11h2M9 15h2M13 15h2"></path>
			case "guia":
				<path d="M2 5h6a4 4 0 0 1 4 4v11a3 3 0 0 0-3-3H2z"></path>
				<path d="M22 5h-6a4 4 0 0 0-4 4v11a3 3 0 0 1 3-3h7z"></path>
			case "novidades":
				<path d="M6 8a6 6 0 1 1 12 0c0 7 3 8 3 8H3s3-1 3-8"></path>
				<path d="M10 20a2 2 0 0 0 4 0"></path>
			case "visitas":
				<path d="M9 11l3 3 8-8"></path>
				<path d="M20 12v7a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h9"></path>
			case "mapa":
				<path d="M9 4 3 6.5v13L9 17l6 3 6-2.5v-13L15 7 9 4z"></path>
				<path d="M9 4v13M15 7v13"></path>
			case "dashboard":
				<circle cx="12" cy="12" r="9"></circle>
				<path d="m12 12 4-4"></path>
				<path d="M7 15.5h.01M8.5 10.5h.01M12 8h.01"></path>
			case "bi":
				<path d="M4 4v16h16"></path>
				<path d="M8 16V10M12 16V7M16 16v-4"></path>
			case "chevron":
				<path d="m9 6 6 6-6 6"></path>
		}
	</svg>
}
